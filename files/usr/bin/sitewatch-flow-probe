#!/bin/ash
set -eu

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_FLOW_RESULTS:=/etc/sitewatch/flow-probes.tsv}"
: "${SITEWATCH_FLOW_UDP_PORTS:=50000-65535 3478 443}"
: "${SITEWATCH_FLOW_TCP_PORTS:=443 50000-65535}"

duration="${1:-0}"
case "$duration" in
	""|*[!0-9]*) duration=0 ;;
esac
[ "$duration" -gt 300 ] && duration=300

tmp1="/tmp/sitewatch-flow-probe-start.$$"
tmp2="/tmp/sitewatch-flow-probe-end.$$"
parsed1="/tmp/sitewatch-flow-probe-start-parsed.$$"
parsed2="/tmp/sitewatch-flow-probe-end-parsed.$$"
trap 'rm -f "$tmp1" "$tmp2" "$parsed1" "$parsed2"' EXIT

snapshot() {
	out="$1"
	if command -v conntrack >/dev/null 2>&1; then
		conntrack -L 2>/dev/null > "$out" || : > "$out"
	elif [ -r /proc/net/nf_conntrack ]; then
		cat /proc/net/nf_conntrack > "$out"
	elif [ -r /proc/net/ip_conntrack ]; then
		cat /proc/net/ip_conntrack > "$out"
	else
		return 1
	fi
}

mkdir -p "$(dirname "$SITEWATCH_FLOW_RESULTS")"

if ! snapshot "$tmp1"; then
	now="$(date +%s)"
	printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$now" "passive" "-" "-" "-" "not_available" "0" "0" "conntrack is not available" >> "$SITEWATCH_FLOW_RESULTS"
	exit 0
fi

if [ "$duration" -gt 0 ]; then
	sleep "$duration"
	snapshot "$tmp2" || : > "$tmp2"
else
	cp "$tmp1" "$tmp2"
fi

parse_snapshot() {
	in="$1"
	out="$2"
	awk -v udp_ranges="$SITEWATCH_FLOW_UDP_PORTS" -v tcp_ranges="$SITEWATCH_FLOW_TCP_PORTS" '
	function in_ranges(port, ranges,    n,a,i,b) {
		n = split(ranges, a, /[ ,]+/);
		for (i = 1; i <= n; i++) {
			if (a[i] == "") continue;
			if (a[i] ~ /-/) {
				split(a[i], b, "-");
				if (port >= b[1] && port <= b[2]) return 1;
			} else if (port == a[i]) return 1;
		}
		return 0;
	}
	function field(name,    i, prefix) {
		prefix = name "=";
		for (i = 1; i <= NF; i++) if (index($i, prefix) == 1) return substr($i, length(prefix) + 1);
		return "";
	}
	function is_lan(ip) {
		return ip ~ /^10\./ || ip ~ /^192\.168\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./ || ip ~ /^fd/ || ip ~ /^fe80:/;
	}
	function is_noise_target(ip) {
		return is_lan(ip) || ip ~ /^127\./ || ip ~ /^0\./ || ip ~ /^169\.254\./ || ip ~ /^224\./ || ip ~ /^239\./ || ip == "255.255.255.255" || ip ~ /\.255$/ || ip ~ /^ff/;
	}
	{
		proto = "";
		for (i = 1; i <= NF; i++) {
			if ($i == "udp" || $i == "tcp") {
				proto = $i;
				break;
			}
		}
		if (proto == "") next;
		src = field("src");
		dst = field("dst");
		dport = field("dport") + 0;
		bytes = field("bytes") + 0;
		packets = field("packets") + 0;
		if (src ~ /^127\./ || src == "" || dst == "" || dport == 0 || !is_lan(src) || is_noise_target(dst)) next;
		if (proto == "udp" && !in_ranges(dport, udp_ranges)) next;
		if (proto == "tcp" && !in_ranges(dport, tcp_ranges)) next;
		assured = ($0 ~ /ASSURED/) ? 1 : 0;
		print proto "\t" src "\t" dst "\t" dport "\t" assured "\t" packets "\t" bytes;
	}
' "$in" > "$out"
}

parse_snapshot "$tmp1" "$parsed1"
parse_snapshot "$tmp2" "$parsed2"

now="$(date +%s)"
awk -F '\t' -v now="$now" -v duration="$duration" '
	BEGIN { OFS = "\t" }
	FNR == NR {
		key = $1 OFS $2 OFS $3 OFS $4;
		start_packets[key] = $6 + 0;
		start_bytes[key] = $7 + 0;
		next;
	}
	{
		key = $1 OFS $2 OFS $3 OFS $4;
		delta_packets = ($6 + 0) - start_packets[key];
		delta_bytes = ($7 + 0) - start_bytes[key];
		if (duration == 0) {
			delta_packets = $6 + 0;
			delta_bytes = $7 + 0;
		}
		if (delta_packets <= 0 && delta_bytes <= 0) next;
		status = "observed";
		detail = duration > 0 ? "delta " duration "s" : "snapshot";
		if (($5 + 0) == 0 && delta_packets > 2) {
			status = "suspect";
			detail = detail ", no ASSURED state";
		}
		print now, "passive-" $1, $2, $3, $4, status, delta_packets, delta_bytes, detail;
	}
' "$parsed1" "$parsed2" >> "$SITEWATCH_FLOW_RESULTS"
