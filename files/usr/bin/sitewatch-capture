#!/bin/ash
set -eu

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_COLLECT_BIN:=/usr/bin/sitewatch-collect}"
: "${SITEWATCH_CAPTURE_STATUS:=/tmp/sitewatch-capture.status}"
: "${SITEWATCH_CAPTURE_LOCK:=/tmp/sitewatch-capture.lock}"

duration="${1:-45}"
case "$duration" in
	''|*[!0-9]*) duration=45 ;;
esac
[ "$duration" -lt 5 ] && duration=5
[ "$duration" -gt 180 ] && duration=180

if ! mkdir "$SITEWATCH_CAPTURE_LOCK" 2>/dev/null; then
	echo "capture already running"
	exit 0
fi

prev="$(uci -q get dhcp.@dnsmasq[0].logqueries || echo __absent__)"

restore_dns_logging() {
	if [ "$prev" = "__absent__" ]; then
		uci -q delete dhcp.@dnsmasq[0].logqueries || true
	else
		uci set dhcp.@dnsmasq[0].logqueries="$prev"
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	rmdir "$SITEWATCH_CAPTURE_LOCK" 2>/dev/null || true
}

trap 'restore_dns_logging' EXIT INT TERM

now="$(date +%s)"
printf "running\t%s\t%s\n" "$now" "$duration" > "$SITEWATCH_CAPTURE_STATUS"

uci set dhcp.@dnsmasq[0].logqueries="1"
uci commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true

sleep "$duration"
"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1 || true

done_at="$(date +%s)"
printf "done\t%s\t%s\n" "$done_at" "$duration" > "$SITEWATCH_CAPTURE_STATUS"
