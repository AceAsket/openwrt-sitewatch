#!/bin/ash
set -eu

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_COLLECT_BIN:=/usr/bin/sitewatch-collect}"
: "${SITEWATCH_CAPTURE_STATUS:=/tmp/sitewatch-capture.status}"
: "${SITEWATCH_CAPTURE_LOCK:=/tmp/sitewatch-capture.lock}"
: "${SITEWATCH_CAPTURE_STOP:=/tmp/sitewatch-capture.stop}"
: "${SITEWATCH_CAPTURE_COLLECT_INTERVAL:=5}"
: "${SITEWATCH_DNSMASQ_CONTROL:=1}"

duration="${1:-45}"
case "$duration" in
	stop)
		now="$(date +%s)"
		printf "stopped\t%s\t0\t%s\n" "$now" "$now" > "$SITEWATCH_CAPTURE_STATUS"
		touch "$SITEWATCH_CAPTURE_STOP"
		exit 0
		;;
	''|*[!0-9]*) duration=45 ;;
esac
if [ "$duration" != "0" ]; then
	[ "$duration" -lt 5 ] && duration=5
	[ "$duration" -gt 600 ] && duration=600
fi

if ! mkdir "$SITEWATCH_CAPTURE_LOCK" 2>/dev/null; then
	echo "capture already running"
	exit 0
fi

have_dnsmasq_control=0
if [ "$SITEWATCH_DNSMASQ_CONTROL" = "1" ] && command -v uci >/dev/null 2>&1 && [ -x /etc/init.d/dnsmasq ]; then
	have_dnsmasq_control=1
	prev="$(uci -q get dhcp.@dnsmasq[0].logqueries || echo __absent__)"
else
	prev="__absent__"
fi

restore_dns_logging() {
	if [ "$have_dnsmasq_control" = "1" ]; then
		if [ "$prev" = "__absent__" ]; then
			uci -q delete dhcp.@dnsmasq[0].logqueries || true
		else
			uci set dhcp.@dnsmasq[0].logqueries="$prev"
		fi
		uci commit dhcp
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	fi
	rmdir "$SITEWATCH_CAPTURE_LOCK" 2>/dev/null || true
	rm -f "$SITEWATCH_CAPTURE_STOP"
}

trap 'restore_dns_logging' EXIT INT TERM

now="$(date +%s)"
printf "running\t%s\t%s\t%s\n" "$now" "$duration" "$now" > "$SITEWATCH_CAPTURE_STATUS"

if [ "$have_dnsmasq_control" = "1" ]; then
	uci set dhcp.@dnsmasq[0].logqueries="1"
	uci commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
fi

elapsed=0
while :; do
	sleep "$SITEWATCH_CAPTURE_COLLECT_INTERVAL"
	"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1 || true
	last_collect="$(date +%s)"
	printf "running\t%s\t%s\t%s\n" "$now" "$duration" "$last_collect" > "$SITEWATCH_CAPTURE_STATUS"

	[ -f "$SITEWATCH_CAPTURE_STOP" ] && break
	if [ "$duration" != "0" ]; then
		elapsed=$((last_collect - now))
		[ "$elapsed" -ge "$duration" ] && break
	fi
done

done_at="$(date +%s)"
if [ -f "$SITEWATCH_CAPTURE_STOP" ]; then
	printf "stopped\t%s\t%s\t%s\n" "$done_at" "$duration" "$done_at" > "$SITEWATCH_CAPTURE_STATUS"
else
	printf "done\t%s\t%s\t%s\n" "$done_at" "$duration" "$done_at" > "$SITEWATCH_CAPTURE_STATUS"
fi
