#!/bin/ash
set -eu

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_QUEUE:=/etc/sitewatch/queue.tsv}"
: "${SITEWATCH_SEEN:=/etc/sitewatch/seen.tsv}"
: "${SITEWATCH_LOG_LINES:=300}"
: "${SITEWATCH_LOG_FILES:=/var/log/pihole/pihole.log /tmp/log/dnsmasq.log /var/log/messages}"
: "${SITEWATCH_USE_LOGREAD:=1}"
: "${SITEWATCH_PIHOLE_API_ENABLED:=0}"
: "${SITEWATCH_PIHOLE_URL:=}"
: "${SITEWATCH_PIHOLE_PASSWORD:=}"
: "${SITEWATCH_PIHOLE_LOOKBACK:=600}"
: "${SITEWATCH_PIHOLE_DISK:=0}"
: "${SITEWATCH_PIHOLE_STATUS:=/tmp/sitewatch-pihole.status}"

mkdir -p "$(dirname "$SITEWATCH_QUEUE")"
touch "$SITEWATCH_QUEUE" "$SITEWATCH_SEEN"

tmp="/tmp/sitewatch-collect.$$"
trap 'rm -f "$tmp" "$tmp.new" /tmp/sitewatch-pihole-parsed.$$' EXIT
: > "$tmp"

for log in $SITEWATCH_LOG_FILES; do
	[ -r "$log" ] || continue
	tail -n "$SITEWATCH_LOG_LINES" "$log" 2>/dev/null | awk '
		/query\[[^]]+\]/ && / from / {
			domain = "";
			source = "";
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^query\[/ && (i + 1) <= NF) domain = $(i + 1);
				if ($i == "from" && (i + 1) <= NF) source = $(i + 1);
			}
			if (domain != "" && source != "" && source !~ /^127\./ && source != "::1") print source "\t" domain;
		}
	' >> "$tmp"
done

if [ "$SITEWATCH_USE_LOGREAD" = "1" ] && command -v logread >/dev/null 2>&1; then
	logread -e 'query[' 2>/dev/null | tail -n "$SITEWATCH_LOG_LINES" | awk '
		/query\[[^]]+\]/ && / from / {
			domain = "";
			source = "";
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^query\[/ && (i + 1) <= NF) domain = $(i + 1);
				if ($i == "from" && (i + 1) <= NF) source = $(i + 1);
			}
			if (domain != "" && source != "" && source !~ /^127\./ && source != "::1") print source "\t" domain;
		}
	' >> "$tmp"
fi

if [ "$SITEWATCH_PIHOLE_API_ENABLED" = "1" ] && [ -n "$SITEWATCH_PIHOLE_URL" ] && [ -n "$SITEWATCH_PIHOLE_PASSWORD" ]; then
	cookie="/tmp/sitewatch-pihole-cookie.$$"
	auth="/tmp/sitewatch-pihole-auth.$$"
	queries="/tmp/sitewatch-pihole-queries.$$"
	parsed="/tmp/sitewatch-pihole-parsed.$$"
	from_ts="$(($(date +%s) - SITEWATCH_PIHOLE_LOOKBACK))"
	url="${SITEWATCH_PIHOLE_URL%/}"
	query_url="$url/api/queries?from=$from_ts"
	if [ "$SITEWATCH_PIHOLE_DISK" = "1" ]; then
		query_url="$url/api/queries?disk=true&from=$from_ts"
	fi
	trap 'rm -f "$tmp" "$tmp.new" "$cookie" "$auth" "$queries" "$parsed"' EXIT
	password_json="$(printf "%s" "$SITEWATCH_PIHOLE_PASSWORD" | sed 's/\\/\\\\/g; s/"/\\"/g')"

	curl -sS -m 8 -c "$cookie" \
		-H "Content-Type: application/json" \
		-d "{\"password\":\"$password_json\"}" \
		"$url/api/auth" > "$auth" 2>/dev/null || true

	csrf="$(jsonfilter -q -i "$auth" -e '@.session.csrf' 2>/dev/null || sed -n 's/.*"csrf"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$auth" | head -n 1)"
	if grep -Eq '"valid"[[:space:]]*:[[:space:]]*true' "$auth"; then
		curl -sS -m 15 -b "$cookie" \
			-H "X-CSRF-TOKEN: $csrf" \
			"$query_url" > "$queries" 2>/dev/null || true

		sed 's/}[[:space:]]*,[[:space:]]*{"id":/}\n{"id":/g' "$queries" | awk '
			function string_field(line, key, tmp) {
				tmp = line;
				if (tmp !~ "\"" key "\"[[:space:]]*:[[:space:]]*\"") return "";
				sub("^.*\"" key "\"[[:space:]]*:[[:space:]]*\"", "", tmp);
				sub("\".*$", "", tmp);
				return tmp;
			}
			/"domain":/ && /"client":/ {
				domain = string_field($0, "domain");
				client = $0;
				source = "";
				if (client ~ /"client"[[:space:]]*:[[:space:]]*\{/) {
					sub(/^.*"client"[[:space:]]*:[[:space:]]*\{/, "", client);
					sub(/\}.*$/, "", client);
					source = string_field(client, "ip");
				} else {
					source = string_field($0, "client");
				}
				if (domain != "" && source != "" && source !~ /^127\./ && source != "::1") print source "\t" domain;
			}
		' > "$parsed"
		cat "$parsed" >> "$tmp"
		query_count="$(wc -l < "$parsed" 2>/dev/null || echo 0)"
		printf "ok\t%s\t%s\t%s\n" "$url" "$query_count" "$(date +%s)" > "$SITEWATCH_PIHOLE_STATUS"
	else
		printf "auth_failed\t%s\t0\t%s\n" "$url" "$(date +%s)" > "$SITEWATCH_PIHOLE_STATUS"
	fi
elif [ "$SITEWATCH_PIHOLE_API_ENABLED" = "1" ]; then
	printf "not_configured\t%s\t0\t%s\n" "${SITEWATCH_PIHOLE_URL:-}" "$(date +%s)" > "$SITEWATCH_PIHOLE_STATUS"
else
	printf "disabled\t%s\t0\t%s\n" "${SITEWATCH_PIHOLE_URL:-}" "$(date +%s)" > "$SITEWATCH_PIHOLE_STATUS"
fi

now="$(date +%s)"

awk -v now="$now" '
	function clean_domain(s) {
		gsub(/\.$/, "", s);
		s = tolower(s);
		return s;
	}
	function valid_domain(s) {
		if (s == "") return 0;
		if (s ~ /[^a-z0-9.-]/) return 0;
		if (s !~ /\./) return 0;
		if (s ~ /\.local$/) return 0;
		if (s ~ /\.lan$/) return 0;
		if (s ~ /\.arpa$/) return 0;
		if (s ~ /^_/ ) return 0;
		return 1;
	}
	BEGIN { FS = "\t"; OFS = "\t"; }
	FNR == NR {
		key = $1 OFS $2;
		first[key] = $3;
		last[key] = $4;
		count[key] = $5;
		next;
	}
	{
		source = $1;
		domain = clean_domain($2);
		if (!valid_domain(domain)) next;
		key = source OFS domain;
		if (!(key in first)) first[key] = now;
		last[key] = now;
		count[key]++;
	}
	END {
		for (key in count) print key, first[key], last[key], count[key];
	}
' "$SITEWATCH_SEEN" "$tmp" > "$tmp.new"

mv "$tmp.new" "$SITEWATCH_SEEN"
cp "$SITEWATCH_SEEN" "$SITEWATCH_QUEUE"
