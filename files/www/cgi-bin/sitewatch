print_network_report_rows() {
	[ -f "$SITEWATCH_FLOW_RESULTS" ] || {
		printf '<tr><td class="empty" colspan="10">Сетевой отчет пока пуст. Запусти пассивное conntrack-наблюдение во время проблемного сервиса.</td></tr>\n'
		return 0
	}
	rows="$(awk -F '\t' -v source_filter="$source_filter" '
		BEGIN { OFS = "\t" }
		function is_noise_target(ip) {
			return ip ~ /^10\./ || ip ~ /^192\.168\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./ || ip ~ /^127\./ || ip ~ /^0\./ || ip ~ /^169\.254\./ || ip ~ /^224\./ || ip ~ /^239\./ || ip == "255.255.255.255" || ip ~ /\.255$/ || ip ~ /^fd/ || ip ~ /^fe80:/ || ip ~ /^ff/;
		}
		NF >= 9 && (source_filter == "" || $3 == source_filter) && !is_noise_target($4) {
			proto = $2;
			sub(/^passive-/, "", proto);
			key = $3 OFS proto OFS $4 OFS $5;
			if (!(key in first) || $1 < first[key]) first[key] = $1;
			if ($1 >= last[key]) {
				last[key] = $1;
				last_status[key] = $6;
				last_detail[key] = $9;
			}
			if ($6 == "suspect") suspect[key] = 1;
			packets[key] += $7 + 0;
			bytes[key] += $8 + 0;
			samples[key]++;
		}
		END {
			for (key in samples) {
				status = suspect[key] ? "suspect" : last_status[key];
				print status, packets[key] + 0, bytes[key] + 0, samples[key] + 0, last[key] + 0, key, last_detail[key];
			}
		}
	' "$SITEWATCH_FLOW_RESULTS" | sort -t "$(printf '\t')" -k1,1r -k2,2nr | head -n 30)"
	if [ -z "$rows" ]; then
		printf '<tr><td class="empty" colspan="10">Для выбранного источника внешних flow пока нет.</td></tr>\n'
		return 0
	fi
	printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r status packets bytes samples last source proto target port detail; do
		[ -n "$source" ] || continue
		last_h="$(date -d "@$last" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$last")"
		status_text="$(network_status_label "$status")"
		detail_text="$(network_detail_label "$detail")"
		printf '<tr><td><span class="status %s">%s</span></td><td class="source">%s</td><td>%s</td><td class="source">%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="muted">%s</td><td class="muted">%s</td></tr>\n' \
			"$(printf "%s" "$status" | html_escape)" "$(printf "%s" "$status_text" | html_escape)" "$(printf "%s" "$source" | html_escape)" "$(printf "%s" "$proto" | html_escape)" "$(printf "%s" "$target" | html_escape)" "$(printf "%s" "$port" | html_escape)" "$(printf "%s" "$packets" | html_escape)" "$(printf "%s" "$bytes" | html_escape)" "$(printf "%s" "$samples" | html_escape)" "$(printf "%s" "$last_h" | html_escape)" "$(printf "%s" "$detail_text" | html_escape)"
	done
}

detector_profile_label() {
	case "$1" in
		quick) echo "Быстрая проверка" ;;
		site) echo "Проблемный сайт" ;;
		discord) echo "Discord / голос" ;;
		full) echo "Полная диагностика" ;;
		*) echo "${1:-не задан}" ;;
	esac
}

detector_kind_label() {
	case "$1" in
		site) echo "Сайт" ;;
		net) echo "Активная сеть" ;;
		flow) echo "Пассивный трафик" ;;
		summary) echo "Итог" ;;
		error) echo "Ошибка" ;;
		*) echo "${1:-событие}" ;;
	esac
}

print_detector_history_rows() {
	[ -f "$SITEWATCH_DETECTOR_HISTORY" ] || {
		printf '<tr><td class="empty" colspan="7">История детектора пока пустая.</td></tr>\n'
		return 0
	}
	rows="$(sort -t "	" -k2,2nr "$SITEWATCH_DETECTOR_HISTORY" 2>/dev/null | head -n 40)"
	if [ -z "$rows" ]; then
		printf '<tr><td class="empty" colspan="7">История детектора пока пустая.</td></tr>\n'
		return 0
	fi
	printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r run_id ts profile target kind status detail source; do
		[ -n "$run_id" ] || continue
		ts_h="$(date -d "@$ts" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$ts")"
		profile_text="$(detector_profile_label "$profile")"
		kind_text="$(detector_kind_label "$kind")"
		if [ "$kind" = "site" ]; then
			status_text="$(status_label "$status")"
		else
			status_text="$(network_status_label "$status")"
		fi
		case "$kind:$status" in
			site:blocked|site:slow|*:suspect|*:timeout|*:error|*:failed|*:not_available) status_class="$status" ;;
			*) status_class="$status" ;;
		esac
		printf '<tr><td class="muted">%s</td><td class="source">%s</td><td>%s</td><td>%s</td><td class="source">%s</td><td><span class="status %s">%s</span></td><td class="muted">%s</td></tr>\n' \
			"$(printf "%s" "$ts_h" | html_escape)" \
			"$(printf "%s" "${source:-Все}" | html_escape)" \
			"$(printf "%s" "$profile_text" | html_escape)" \
			"$(printf "%s" "$kind_text" | html_escape)" \
			"$(printf "%s" "$target" | html_escape)" \
			"$(printf "%s" "$status_class" | html_escape)" \
			"$(printf "%s" "$status_text" | html_escape)" \
			"$(printf "%s" "$detail" | html_escape)"
	done
}

print_network_export() {
	status_filter="$1"
	mode="$2"
	[ -f "$SITEWATCH_FLOW_RESULTS" ] || return 0
	awk -F '\t' -v status_filter="$status_filter" -v mode="$mode" -v source_filter="$source_filter" '
		function is_noise_target(ip) {
			return ip ~ /^10\./ || ip ~ /^192\.168\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[0-1])\./ || ip ~ /^127\./ || ip ~ /^0\./ || ip ~ /^169\.254\./ || ip ~ /^224\./ || ip ~ /^239\./ || ip == "255.255.255.255" || ip ~ /\.255$/ || ip ~ /^fd/ || ip ~ /^fe80:/ || ip ~ /^ff/;
		}
		NF >= 9 && (source_filter == "" || $3 == source_filter) && !is_noise_target($4) {
			proto = $2;
			sub(/^passive-/, "", proto);
			key = proto "\t" $4 "\t" $5;
			if ($6 == "suspect") suspect[key] = 1;
			seen[key] = 1;
		}
		END {
			for (key in seen) {
				if (status_filter == "suspect" && !suspect[key]) continue;
				split(key, p, "\t");
				proto = p[1];
				ip = p[2];
				port = p[3];
				if (mode == "v2raya") {
					print "ip(" ip ") -> proxy";
				} else if (mode == "csv") {
					print proto "," ip "," port "," (suspect[key] ? "suspect" : "observed");
				} else {
					print proto ":" ip ":" port;
				}
			}
		}
	' "$SITEWATCH_FLOW_RESULTS" | sort -u
}

