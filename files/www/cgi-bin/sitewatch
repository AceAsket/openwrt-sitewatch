<body>
<main>
<section class="top">
<div class="brand"><div class="mark">SW</div><div><h1>SiteWatch</h1><div class="subtitle">Мониторинг блокировок по устройствам без постоянного DNS-логирования</div></div></div>
<div class="actions">
<button class="button" id="themeToggle" type="button">Dark</button>
</div>
</section>

<section class="capture-banner ${capture_state:-idle}" id="captureBanner" data-state="$capture_state" data-start="$capture_time" data-duration="$capture_duration" data-remaining="$capture_remaining">
<div class="capture-left"><span class="pulse"></span><div><b id="captureTitle">$capture_text</b><div class="muted" id="captureDetail">Новые DNS-запросы подхватываются автоматически во время активного окна.</div></div></div>
<div class="capture-meta"><span class="timer" id="captureTimer">${capture_remaining:-}</span> <span class="live-tag" id="captureMode">${capture_state:-idle}</span></div>
</section>

<section class="toolbar">
<div class="tool">
<div class="tool-title">Проверка устройства</div>
<form method="get" action="">
<input type="hidden" name="action" value="scan">
<label>Источник</label>
<input name="source" value="$source_filter_e" placeholder="192.168.50.105">
<button class="button primary" type="submit">Сканировать устройство</button>
<a class="button" href="?">Сбросить фильтр</a>
</form>
<div class="capture">$capture_text</div>
</div>
<div class="tool">
<div class="tool-title">Окно наблюдения</div>
<form method="get" action="">
<input type="hidden" name="action" value="capture">
<select name="duration"><option value="30">30 сек</option><option value="45" selected>45 сек</option><option value="90">90 сек</option><option value="180">180 сек</option><option value="300">300 сек</option></select>
<button class="button warn" type="submit">Запустить</button>
<a class="button warn" href="?action=capture_live$source_q">Live</a>
<a class="button danger" href="?action=capture_stop$source_q">Стоп</a>
</form>
</div>
</section>

<section class="summary">
<div class="stat wide"><div class="k">Фильтр / последний скан</div><span class="v" id="summaryScope">$source_title_e · $last_scan</span></div>
<div class="stat"><div class="k">DNS-запросов</div><span class="v" id="summarySeen">$total_seen</span></div>
<div class="stat"><div class="k">Проверено</div><span class="v" id="summaryResults">$total_results</span></div>
<div class="stat"><div class="k">VPN-список</div><span class="v" id="summaryProxy">$total_proxy</span></div>
<div class="stat"><div class="k">Ожидает</div><span class="v">$unchecked_count</span></div>
</section>

<section class="health">
<div class="pill-card"><span><span class="dot blocked"></span>Заблокированы</span><b>$blocked_count</b></div>
<div class="pill-card"><span><span class="dot slow"></span>Замедлены</span><b>$slow_count</b></div>
<div class="pill-card"><span><span class="dot ok"></span>Норма</span><b>$ok_count</b></div>
<div class="pill-card"><span><span class="dot proxy_failed"></span>Proxy fail</span><b>$failed_count</b></div>
<div class="pill-card"><span><span class="dot unchecked"></span>Ожидают</span><b>$unchecked_count</b></div>
</section>

<section class="manual-panel">
<div class="tool-title">Ручная проверка URL</div>
<form method="get" action="" id="manualCheckForm">
<input type="hidden" name="action" value="manual_check">
<input type="text" name="url" value="$manual_url_e" placeholder="https://youmagine.com/">
<label class="checkline"><input type="checkbox" name="add" value="1"> добавить в VPN-список при блокировке</label>
<button class="button primary" type="submit">Проверить URL</button>
</form>
<div class="manual-loading"><span class="spinner"></span><span>Проверяем напрямую и через v2rayA</span></div>
<div class="manual-result" id="manualResult">
EOF

if [ -n "$manual_result" ]; then
cat <<EOF
<div class="manual-metric"><span>Статус</span><b><span class="status $manual_status_e">$manual_status_text_e</span></b></div>
<div class="manual-metric"><span>Домен</span><b>$manual_domain_e</b></div>
<div class="manual-metric"><span>Напрямую</span><b>$manual_direct_code_e / ${manual_direct_time_e}s</b></div>
<div class="manual-metric"><span>Через v2rayA</span><b>$manual_proxy_code_e / ${manual_proxy_time_e}s</b></div>
<div class="manual-metric"><span>URL</span><b>$manual_checked_url_e</b></div>
<div class="manual-metric"><span>VPN-список</span><b>$manual_added_e</b></div>
<details class="manual-dpi">
<summary>DPI-диагностика</summary>
<div class="manual-dpi-grid">
<div class="manual-metric"><span>DNS DPI</span><b>$manual_dns_status_e · UDP $manual_dns_udp_ip_e · DoH $manual_dns_doh_ip_e</b></div>
<div class="manual-metric"><span>TLS 1.3</span><b>$manual_tls13_status_e / ${manual_tls13_time_e}s</b></div>
<div class="manual-metric"><span>TLS 1.2</span><b>$manual_tls12_status_e / ${manual_tls12_time_e}s</b></div>
<div class="manual-metric"><span>HTTP probe</span><b>$manual_http_status_e / $manual_http_code_e</b></div>
</div>
</details>
EOF
fi

cat <<EOF
</div>
</section>

<section class="utility-grid">
<div class="source-panel">
<div class="tool-title">Источники DNS</div>
<div class="source-grid">
<div class="source-card">
<div class="source-row"><b>dnsmasq / logread</b><span class="source-state">local</span></div>
<div class="muted">Включается на время окна наблюдения, затем выключается обратно.</div>
</div>
<div class="source-card">
<div class="source-row"><b>Pi-hole API</b><span class="source-state">$pihole_state</span></div>
<div class="muted">$pihole_label_e</div>
<div class="muted">URL: $pihole_url_e · проверка: $pihole_checked_human</div>
<div style="margin-top:8px"><a class="button" href="?action=pihole_check$source_q">Проверить Pi-hole</a></div>
</div>
</div>
</div>

<div class="export-panel">
<div class="tool-title">Выгрузка правил</div>
<div class="export-grid">
<a class="button" href="?action=export">domain: список</a>
<a class="button" href="?action=export_base">Базовые домены</a>
<a class="button" href="?action=export_v2raya">v2rayA rules</a>
<a class="button" href="?action=export_v2raya_base">v2rayA base</a>
</div>
</div>
</section>

<nav class="sources">
<a class="chip" href="?">Все устройства</a>
EOF

awk -F '\t' '{
	count[$1] += $5;
}
END {
	for (source in count) print source, count[source];
}' "$SITEWATCH_SEEN" 2>/dev/null | sort | head -n 24 | while read -r src cnt; do
	[ -n "$src" ] || continue
	src_e="$(printf "%s" "$src" | html_escape)"
	active=""
	[ "$src" = "$source_filter" ] && active=" active"
	printf '<a class="chip%s" href="?source=%s">%s <small>%s</small></a>\n' "$active" "$src_e" "$src_e" "$cnt"
done

cat <<EOF
</nav>

<section class="panel">
<div class="panel-head"><div class="panel-title">Домены: $source_title_e</div><div class="hint">Live-режим обновляет счетчики без перезагрузки страницы</div></div>
<table>
<thead><tr><th>Статус</th><th>Домен</th><th>Источник</th><th>Запросов</th><th>Напрямую</th><th>Через v2rayA</th><th>Скан</th></tr></thead>
<tbody>
EOF

rows="$(
awk -F '\t' -v source_filter="$source_filter" '
	BEGIN { OFS = "\t"; }
	FNR == NR {
		if (source_filter == "" || $1 == source_filter) {
			source[$2] = $1;
			queries[$2] += $5;
		}
		next;
	}
	{
		domain = $1;
		if (source_filter == "" || $2 == source_filter) {
			print $4, domain, $2, $3, $5 " / " $6 "s", $7 " / " $8 "s", $9;
			done[domain] = 1;
		}
	}
	END {
		for (domain in queries) {
			if (!(domain in done)) print "unchecked", domain, source[domain], queries[domain], "-", "-", "";
		}
	}
' "$SITEWATCH_SEEN" "$SITEWATCH_RESULTS" 2>/dev/null | sort -t "	" -k1,1 -k4,4nr | head -n 250
)"

if [ -z "$rows" ]; then
	printf '<tr><td class="empty" colspan="7">Нет данных для выбранного источника. Запусти окно наблюдения и открой нужный сайт с устройства.</td></tr>\n'
else
	printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r status domain source count direct proxy scanned; do
		[ -n "$domain" ] || continue
		status_class="$(printf "%s" "$status" | html_escape)"
		status_text="$(status_label "$status" | html_escape)"
		domain_e="$(printf "%s" "$domain" | html_escape)"
		source_e="$(printf "%s" "$source" | html_escape)"
		direct_e="$(printf "%s" "$direct" | html_escape)"
		proxy_e="$(printf "%s" "$proxy" | html_escape)"
		if [ -n "$scanned" ] && [ "$scanned" != "-" ]; then
			scanned="$(date -d "@$scanned" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$scanned")"
		else
			scanned="-"
		fi
		printf '<tr><td><span class="status %s">%s</span></td><td class="domain">%s</td><td class="source">%s</td><td>%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="muted">%s</td></tr>\n' \
			"$status_class" "$status_text" "$domain_e" "$source_e" "$count" "$direct_e" "$proxy_e" "$scanned"
	done
fi

cat <<'EOF'
</tbody></table>
</section>
</main>
<script>
(function(){
  var root = document.documentElement;
  var button = document.getElementById('themeToggle');
  var params = new URLSearchParams(window.location.search);
  var requested = params.get('theme');
  var saved = requested === 'light' || requested === 'dark' ? requested : localStorage.getItem('sitewatch-theme');
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  function apply(theme){
    root.setAttribute('data-theme', theme);
    localStorage.setItem('sitewatch-theme', theme);
    if (button) button.textContent = theme === 'dark' ? 'Light' : 'Dark';
  }
  apply(saved || (prefersDark ? 'dark' : 'light'));
  if (button) {
    button.addEventListener('click', function(){
      apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  }
})();
</script>
<script>
(function(){
  var endpoint = window.location.pathname || '/';
  var banner = document.getElementById('captureBanner');
  var timer = document.getElementById('captureTimer');
  var mode = document.getElementById('captureMode');
  var title = document.getElementById('captureTitle');
  var seen = document.getElementById('summarySeen');
  var results = document.getElementById('summaryResults');
  var proxyTotal = document.getElementById('summaryProxy');
  var source = '$source_filter_e';
  var reloadedAfterDone = false;
  function parseStatus(text){
    var out = {};
    text.trim().split('\n').forEach(function(line){
      var idx = line.indexOf('=');
      if (idx > -1) out[line.slice(0, idx)] = line.slice(idx + 1);
    });
    return out;
  }
  function setCapture(raw){
    if (!raw || !banner) return;
    var parts = raw.split('\t');
    var state = parts[0] || 'idle';
    var start = parts[1] || '';
    var duration = parts[2] || '0';
    banner.setAttribute('data-state', state);
    banner.setAttribute('data-start', start);
    banner.setAttribute('data-duration', duration);
    banner.className = 'capture-banner ' + state;
    if (title) {
      if (state === 'running' && duration === '0') title.textContent = 'Идет live-наблюдение без таймера';
      else if (state === 'running') title.textContent = 'Идет окно наблюдения: ' + duration + ' сек';
      else if (state === 'done') title.textContent = 'Окно наблюдения завершено';
      else if (state === 'stopped') title.textContent = 'Live-наблюдение остановлено';
    }
  }
  function render(){
    if (!banner || !timer || !mode) return;
    var state = banner.getAttribute('data-state') || 'idle';
    var duration = parseInt(banner.getAttribute('data-duration') || '0', 10);
    var start = parseInt(banner.getAttribute('data-start') || '0', 10);
    if (state === 'running' && duration > 0 && start > 0) {
      var left = Math.max(0, start + duration - Math.floor(Date.now() / 1000));
      timer.textContent = left + 's';
      mode.textContent = 'timer';
      if (left === 0 && !reloadedAfterDone) {
        reloadedAfterDone = true;
        setTimeout(function(){ location.reload(); }, 2200);
      }
    } else if (state === 'running') {
      timer.textContent = 'live';
      mode.textContent = 'manual';
    } else {
      timer.textContent = '';
      mode.textContent = state || 'idle';
    }
  }
  render();
  setInterval(render, 1000);
  function refreshStatus(){
    if (!banner) return;
      var url = endpoint + '?action=status' + (source ? '&source=' + encodeURIComponent(source) : '');
      fetch(url, {cache:'no-store'}).then(function(resp){ return resp.text(); }).then(function(text){
        var data = parseStatus(text);
        if (data.capture) setCapture(data.capture);
        if (data.seen && seen) seen.textContent = data.seen;
        if (data.results && results) results.textContent = data.results;
        if (data.proxy && proxyTotal) proxyTotal.textContent = data.proxy;
        render();
      }).catch(function(){});
  }
  setTimeout(refreshStatus, 1200);
  setInterval(refreshStatus, 6000);
})();
</script>
<script>
(function(){
  var endpoint = window.location.pathname || '/';
  var form = document.getElementById('manualCheckForm');
  var panel = form ? form.closest('.manual-panel') : null;
  var result = document.getElementById('manualResult');
  var proxyTotal = document.getElementById('summaryProxy');
  if (!form || !panel || !result || !window.fetch) return;

  var labels = {
    blocked: 'заблокирован',
    slow: 'замедлен',
    ok: 'норма',
    proxy_failed: 'proxy fail',
    error: 'ошибка'
  };

  function parseTSV(text){
    var out = {};
    text.trim().split('\n').forEach(function(line){
      var idx = line.indexOf('\t');
      if (idx > -1) out[line.slice(0, idx)] = line.slice(idx + 1);
    });
    return out;
  }

  function text(value){
    return value == null || value === '' ? '-' : String(value);
  }

  function metric(title, body){
    var box = document.createElement('div');
    box.className = 'manual-metric';
    var label = document.createElement('span');
    label.textContent = title;
    var value = document.createElement('b');
    if (body instanceof Node) value.appendChild(body);
    else value.textContent = text(body);
    box.appendChild(label);
    box.appendChild(value);
    return box;
  }

  function render(data){
    result.textContent = '';
    var status = data.status || 'error';
    var badge = document.createElement('span');
    badge.className = 'status ' + status;
    badge.textContent = labels[status] || status;
    result.appendChild(metric('Статус', badge));
    result.appendChild(metric('Домен', data.domain));
    result.appendChild(metric('Напрямую', text(data.direct_code) + ' / ' + text(data.direct_time) + 's'));
    result.appendChild(metric('Через v2rayA', text(data.proxy_code) + ' / ' + text(data.proxy_time) + 's'));
    result.appendChild(metric('URL', data.url));
    result.appendChild(metric('VPN-список', data.added || data.error || 'no'));
    var details = document.createElement('details');
    details.className = 'manual-dpi';
    var summary = document.createElement('summary');
    summary.textContent = 'DPI-диагностика';
    var grid = document.createElement('div');
    grid.className = 'manual-dpi-grid';
    grid.appendChild(metric('DNS DPI', text(data.dns_status) + ' · UDP ' + text(data.dns_udp_ip) + ' · DoH ' + text(data.dns_doh_ip)));
    grid.appendChild(metric('TLS 1.3', text(data.tls13_status) + ' / ' + text(data.tls13_time) + 's'));
    grid.appendChild(metric('TLS 1.2', text(data.tls12_status) + ' / ' + text(data.tls12_time) + 's'));
    grid.appendChild(metric('HTTP probe', text(data.http_status) + ' / ' + text(data.http_code)));
    details.appendChild(summary);
    details.appendChild(grid);
    result.appendChild(details);
  }

  function cleanManualInput(value){
    var raw = String(value || '').replace(/\s+/g, '').replace(/^[ "'`<>\[\]{}(),;]+|[ "'`<>\[\]{}(),;]+$/g, '');
    var idx = raw.toLowerCase().indexOf('domain:');
    if (idx >= 0) {
      raw = raw.slice(idx + 7).replace(/^[ "'`<>\[\]{}(),;]+/, '');
      var match = raw.match(/^[A-Za-z0-9.-]+/);
      raw = match ? match[0] : '';
    }
    return raw;
  }

  form.addEventListener('submit', function(event){
    event.preventDefault();
    var input = form.querySelector('input[name="url"]');
    if (input) input.value = cleanManualInput(input.value);
    var params = new URLSearchParams(new FormData(form));
    params.set('action', 'manual_check_api');
    panel.classList.add('loading');
    result.textContent = '';
    var button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    fetch(endpoint + '?' + params.toString(), {cache:'no-store'})
      .then(function(resp){ return resp.text(); })
      .then(function(body){
        var data = parseTSV(body);
        render(data);
        if ((data.added === 'yes' || data.added === 'already') && proxyTotal) {
          fetch(endpoint + '?action=status', {cache:'no-store'})
            .then(function(resp){ return resp.text(); })
            .then(function(text){
              var status = parseTSV(text.replace(/=/g, '\t'));
              if (status.proxy) proxyTotal.textContent = status.proxy;
            }).catch(function(){});
        }
      })
      .catch(function(){
        render({status:'error', error:'network'});
      })
      .finally(function(){
        panel.classList.remove('loading');
        if (button) button.disabled = false;
      });
  });
})();
</script>
</body>
</html>
