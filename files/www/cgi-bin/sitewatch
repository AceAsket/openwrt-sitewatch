active_capture_status="$SITEWATCH_CAPTURE_STATUS"
if [ "$SITEWATCH_RUN_MODE" = "agent" ]; then
	active_capture_bin="$SITEWATCH_AGENT_BIN"
	active_capture_status="$SITEWATCH_AGENT_STATUS"
fi
[ -n "$duration" ] || duration=45
source_q=""
[ -n "$source_filter" ] && source_q="&source=$source_filter"
manual_result=""

case "$action" in
	capture)
		"$active_capture_bin" "$duration" >/dev/null 2>&1 &
		history_event capture "$duration"
		sleep 1
		redirect_clean overview
		;;
	capture_live)
		"$active_capture_bin" 0 >/dev/null 2>&1 &
		history_event live 0
		sleep 1
		redirect_clean overview
		;;
	capture_stop)
		"$active_capture_bin" stop >/dev/null 2>&1
		history_event stop 0
		sleep 1
		redirect_clean overview
		;;
	collect)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		redirect_clean overview
		;;
	pihole_check)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		redirect_clean settings
		;;
	net_probe)
		[ -n "$probe_target" ] || probe_target="$SITEWATCH_PROBE_TARGET"
		"$SITEWATCH_NET_PROBE_BIN" "$probe_mode" "$probe_target" "$probe_ports" >/dev/null 2>&1 || true
		redirect_clean diagnostics
		;;
	flow_probe)
		"$SITEWATCH_FLOW_PROBE_BIN" "$flow_duration" >/dev/null 2>&1 || true
		redirect_clean diagnostics
		;;
	detector_start)
		"$SITEWATCH_DETECTOR_BIN" "$detector_profile" "$detector_url" "$detector_target" "$detector_ports" "$detector_duration" "$detector_source" >/dev/null 2>&1 &
		sleep 1
		redirect_clean detector
		;;
	detector_clear)
		: > "$SITEWATCH_DETECTOR_HISTORY"
		rm -f "$SITEWATCH_DETECTOR_STATUS"
		redirect_clean detector
		;;
	save_settings)
		save_config_value SITEWATCH_SCAN_WORKERS "$scan_workers"
		save_config_value SITEWATCH_RETENTION_DAYS "$retention_days"
		save_config_value SITEWATCH_RUN_MODE "$run_mode"
