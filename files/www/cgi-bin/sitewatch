<a class="button" href="?action=export_v2raya">v2rayA rules</a>
<a class="button" href="?action=export_v2raya_base">v2rayA base</a>
</div>
</section>

<nav class="sources">
<a class="chip" href="/cgi-bin/sitewatch">Все устройства</a>
EOF

awk -F '\t' '{
	count[$1] += $5;
}
END {
	for (source in count) print source, count[source];
}' "$SITEWATCH_SEEN" 2>/dev/null | sort | head -n 24 | while read -r src cnt; do
	[ -n "$src" ] || continue
	src_e="$(printf "%s" "$src" | html_escape)"
	active=""
	[ "$src" = "$source_filter" ] && active=" active"
	printf '<a class="chip%s" href="?source=%s">%s <small>%s</small></a>\n' "$active" "$src_e" "$src_e" "$cnt"
done

cat <<EOF
</nav>

<section class="panel">
<div class="panel-head"><div class="panel-title">Домены: $source_title_e</div><div class="hint">Страница обновляется раз в 2 минуты</div></div>
<table>
<thead><tr><th>Статус</th><th>Домен</th><th>Источник</th><th>Запросов</th><th>Напрямую</th><th>Через v2rayA</th><th>Скан</th></tr></thead>
<tbody>
EOF

rows="$(
awk -F '\t' -v source_filter="$source_filter" '
	BEGIN { OFS = "\t"; }
	FNR == NR {
		if (source_filter == "" || $1 == source_filter) {
			source[$2] = $1;
			queries[$2] += $5;
		}
		next;
	}
	{
		domain = $1;
		if (source_filter == "" || $2 == source_filter) {
			print $4, domain, $2, $3, $5 " / " $6 "s", $7 " / " $8 "s", $9;
			done[domain] = 1;
		}
	}
	END {
		for (domain in queries) {
			if (!(domain in done)) print "unchecked", domain, source[domain], queries[domain], "-", "-", "";
		}
	}
' "$SITEWATCH_SEEN" "$SITEWATCH_RESULTS" 2>/dev/null | sort -t "	" -k1,1 -k4,4nr | head -n 250
)"

if [ -z "$rows" ]; then
	printf '<tr><td class="empty" colspan="7">Нет данных для выбранного источника. Запусти окно наблюдения и открой нужный сайт с устройства.</td></tr>\n'
else
	printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r status domain source count direct proxy scanned; do
		[ -n "$domain" ] || continue
		status_class="$(printf "%s" "$status" | html_escape)"
		status_text="$(status_label "$status" | html_escape)"
		domain_e="$(printf "%s" "$domain" | html_escape)"
		source_e="$(printf "%s" "$source" | html_escape)"
		direct_e="$(printf "%s" "$direct" | html_escape)"
		proxy_e="$(printf "%s" "$proxy" | html_escape)"
		if [ -n "$scanned" ] && [ "$scanned" != "-" ]; then
			scanned="$(date -d "@$scanned" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$scanned")"
		else
			scanned="-"
		fi
		printf '<tr><td><span class="status %s">%s</span></td><td class="domain">%s</td><td class="source">%s</td><td>%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="muted">%s</td></tr>\n' \
			"$status_class" "$status_text" "$domain_e" "$source_e" "$count" "$direct_e" "$proxy_e" "$scanned"
	done
fi

cat <<'EOF'
</tbody></table>
</section>
</main>
<script>
(function(){
  var root = document.documentElement;
  var button = document.getElementById('themeToggle');
  var saved = localStorage.getItem('sitewatch-theme');
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  function apply(theme){
    root.setAttribute('data-theme', theme);
    localStorage.setItem('sitewatch-theme', theme);
    if (button) button.textContent = theme === 'dark' ? 'Light' : 'Dark';
  }
  apply(saved || (prefersDark ? 'dark' : 'light'));
  if (button) {
    button.addEventListener('click', function(){
      apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  }
})();
</script>
<script>
(function(){
  var banner = document.getElementById('captureBanner');
  var timer = document.getElementById('captureTimer');
  var mode = document.getElementById('captureMode');
  var source = '$source_filter_e';
  function render(){
    if (!banner || !timer || !mode) return;
    var state = banner.getAttribute('data-state') || 'idle';
    var duration = parseInt(banner.getAttribute('data-duration') || '0', 10);
    var start = parseInt(banner.getAttribute('data-start') || '0', 10);
    if (state === 'running' && duration > 0 && start > 0) {
      var left = Math.max(0, start + duration - Math.floor(Date.now() / 1000));
      timer.textContent = left + 's';
      mode.textContent = 'timer';
      if (left === 0) setTimeout(function(){ location.reload(); }, 1400);
    } else if (state === 'running') {
      timer.textContent = 'live';
      mode.textContent = 'manual';
    } else {
      timer.textContent = '';
      mode.textContent = state || 'idle';
    }
  }
  render();
  setInterval(render, 1000);
  if (banner && banner.getAttribute('data-state') === 'running') {
    setInterval(function(){
      var url = '/cgi-bin/sitewatch?action=status' + (source ? '&source=' + encodeURIComponent(source) : '');
      fetch(url, {cache:'no-store'}).then(function(){ location.reload(); }).catch(function(){});
    }, 6000);
  }
})();
</script>
</body>
</html>
EOF
