		save_config_value SITEWATCH_PIHOLE_URL "$pihole_url"
		save_config_value SITEWATCH_PIHOLE_PASSWORD "$pihole_password"
		save_config_value SITEWATCH_PIHOLE_LOOKBACK "$pihole_lookback"
		save_config_value SITEWATCH_PIHOLE_LIMIT "$pihole_limit"
		save_config_value SITEWATCH_PIHOLE_DISK "$pihole_disk"
		save_config_value SITEWATCH_PROBE_TARGET "$probe_target"
		save_config_value SITEWATCH_PROBE_MODE "$probe_mode"
		save_config_value SITEWATCH_PROBE_PORTS "$probe_ports"
		save_config_value SITEWATCH_DNS_SOURCE "$dns_source"
		SITEWATCH_RUN_MODE="$run_mode"
		SITEWATCH_RETENTION_DAYS="$retention_days"
		SITEWATCH_AGENT_INGEST_URL="$agent_ingest_url"
		SITEWATCH_INGEST_TOKEN="$settings_token"
		SITEWATCH_PIHOLE_API_ENABLED="$pihole_enabled"
		SITEWATCH_PIHOLE_URL="$pihole_url"
		SITEWATCH_PIHOLE_PASSWORD="$pihole_password"
		SITEWATCH_PIHOLE_LOOKBACK="$pihole_lookback"
		SITEWATCH_PIHOLE_LIMIT="$pihole_limit"
		SITEWATCH_PIHOLE_DISK="$pihole_disk"
		SITEWATCH_PROBE_TARGET="$probe_target"
		SITEWATCH_PROBE_MODE="$probe_mode"
		SITEWATCH_PROBE_PORTS="$probe_ports"
		SITEWATCH_DNS_SOURCE="$dns_source"
		active_capture_bin="$SITEWATCH_CAPTURE_BIN"
		active_capture_status="$SITEWATCH_CAPTURE_STATUS"
		if [ "$SITEWATCH_RUN_MODE" = "agent" ]; then
			active_capture_bin="$SITEWATCH_AGENT_BIN"
			active_capture_status="$SITEWATCH_AGENT_STATUS"
		fi
		redirect_clean settings
		;;
	agent_check)
		now="$(date +%s)"
		if [ -z "$SITEWATCH_AGENT_INGEST_URL" ]; then
			printf "not_configured\t%s\t%s\n" "no_container_address" "$now" > "$SITEWATCH_AGENT_CHECK_STATUS"
