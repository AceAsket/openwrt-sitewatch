:root[data-theme="dark"] .button{background:#151c26;color:var(--text);box-shadow:0 1px 1px rgba(0,0,0,.25)}
:root[data-theme="dark"] .button.warn{background:#2b2414;border-color:#7a5a1c;color:#ffd37a}
:root[data-theme="dark"] .button.danger{background:#301b20;border-color:#7b3440;color:#ffb3bb}
:root[data-theme="dark"] .button.primary{background:var(--blue);border-color:var(--blue);color:#fff}
:root[data-theme="dark"] .tab-button.active{background:var(--panel);border-color:var(--line);color:var(--text)}
:root[data-theme="dark"] .tool,:root[data-theme="dark"] .stat,:root[data-theme="dark"] .panel,:root[data-theme="dark"] .chip,:root[data-theme="dark"] .export-panel,:root[data-theme="dark"] .source-panel,:root[data-theme="dark"] .manual-panel{background:var(--panel);box-shadow:0 12px 30px rgba(0,0,0,.24)}
:root[data-theme="dark"] .source-card{background:#111821}
:root[data-theme="dark"] .tool input,:root[data-theme="dark"] .tool select,:root[data-theme="dark"] .manual-panel input[type="text"],:root[data-theme="dark"] .export-grid select,:root[data-theme="dark"] .settings-form input,:root[data-theme="dark"] .settings-form select{background:#0f1620;color:var(--text)}
:root[data-theme="dark"] .scan-workers input{background:#0f1620;color:var(--text)}
:root[data-theme="dark"] .manual-metric,:root[data-theme="dark"] .manual-dpi{background:#111821}
:root[data-theme="dark"] .notice.warn{background:#2b2414;border-color:#7a5a1c;color:#ffd37a}:root[data-theme="dark"] .codebox{background:#111821}
:root[data-theme="dark"] .chip.active{background:#e7edf5;color:#111821;border-color:#e7edf5}
:root[data-theme="dark"] .chip.active small{color:#475569}
:root[data-theme="dark"] th{background:var(--panel2);color:var(--muted)}
:root[data-theme="dark"] td{border-bottom-color:var(--line)}
:root[data-theme="dark"] tbody tr:hover{background:#192332}
:root[data-theme="dark"] .status.blocked{background:#3a1b24;color:#ff8994}
:root[data-theme="dark"] .status.slow{background:#332713;color:#ffd37a}
:root[data-theme="dark"] .status.ok,:root[data-theme="dark"] .status.done{background:#173322;color:#6ee092}
:root[data-theme="dark"] .status.proxy_failed{background:#27303d;color:#b4bfcd}
:root[data-theme="dark"] .status.unchecked{background:#202a37;color:#aab4c4}
:root[data-theme="dark"] .status.suspect{background:#332713;color:#ffd37a}:root[data-theme="dark"] .status.observed{background:#173322;color:#6ee092}:root[data-theme="dark"] .status.timeout,:root[data-theme="dark"] .status.error,:root[data-theme="dark"] .status.failed,:root[data-theme="dark"] .status.not_available{background:#3a1b24;color:#ff8994}
:root[data-theme="dark"] .diag-state.ok{background:#173322;color:#6ee092}:root[data-theme="dark"] .diag-state.warn{background:#332713;color:#ffd37a}:root[data-theme="dark"] .diag-state.off{background:#202a37;color:#aab4c4}
:root[data-theme="dark"] .capture-banner{background:var(--panel);box-shadow:0 12px 30px rgba(0,0,0,.28)}
:root[data-theme="dark"] .scan-progress{background:var(--panel)}:root[data-theme="dark"] .bar{background:#202a37}
@media(max-width:900px){main{padding:14px}.top{display:block}.actions{justify-content:flex-start;margin-top:14px}.mode-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.capture-banner{grid-template-columns:1fr}.capture-meta{justify-content:flex-start}.toolbar,.utility-grid,.settings-form{grid-template-columns:1fr}.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.stat.wide{grid-column:1/-1}.source-grid,.manual-result,.manual-dpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.manual-panel form{grid-template-columns:1fr}th:nth-child(5),td:nth-child(5),th:nth-child(6),td:nth-child(6){display:none}}
