case "$probe_mode" in udp|tcp|both) ;; *) probe_mode="$SITEWATCH_PROBE_MODE" ;; esac
probe_ports="$(printf "%s" "$(safe_token "$(param probe_ports)")" | sed 's/[^0-9,]//g')"
[ -n "$probe_ports" ] || probe_ports="$SITEWATCH_PROBE_PORTS"
flow_duration="$(normalize_int_range "$(safe_token "$(param flow_duration)")" 0 300 45)"
detector_profile="$(safe_token "$(param detector_profile)")"
case "$detector_profile" in quick|site|discord|full) ;; *) detector_profile="quick" ;; esac
detector_url="$(url_decode_light "$(param detector_url)")"
detector_source="$(safe_token "$(param detector_source)")"
detector_target="$(normalize_container_addr "$(url_decode_light "$(param detector_target)")")"
detector_ports="$(printf "%s" "$(safe_token "$(param detector_ports)")" | sed 's/[^0-9,]//g')"
[ -n "$detector_ports" ] || detector_ports="$SITEWATCH_PROBE_PORTS"
detector_duration="$(normalize_int_range "$(safe_token "$(param detector_duration)")" 0 300 45)"
dns_source="$(safe_token "$(param dns_source)")"
case "$dns_source" in auto|dnsmasq|packet|both) ;; *) dns_source="$SITEWATCH_DNS_SOURCE" ;; esac
case "$dns_source" in auto|dnsmasq|packet|both) ;; *) dns_source="auto" ;; esac
scan_workers="$(normalize_scan_workers "$(safe_token "$(param scan_workers)")")"
[ -n "$scan_workers" ] || scan_workers="$(normalize_scan_workers "$SITEWATCH_SCAN_WORKERS")"
[ -n "$scan_workers" ] || scan_workers=4
retention_days="$(normalize_retention_days "$(safe_token "$(param retention_days)")")"
[ -n "$retention_days" ] || retention_days="$(normalize_retention_days "$SITEWATCH_RETENTION_DAYS")"
[ -n "$retention_days" ] || retention_days=30
SITEWATCH_SCAN_WORKERS="$scan_workers"
SITEWATCH_RETENTION_DAYS="$retention_days"
SITEWATCH_RUN_MODE="$(normalize_run_mode "$SITEWATCH_RUN_MODE")"
SITEWATCH_AGENT_INGEST_URL="$(normalize_container_addr "$SITEWATCH_AGENT_INGEST_URL")"
if [ "$SITEWATCH_RUN_MODE" = "agent" ] && [ "$active_tab" != "settings" ]; then
	active_tab="overview"
fi
