:root[data-theme="dark"] .chip.active small{color:#475569}
:root[data-theme="dark"] th{background:var(--panel2);color:var(--muted)}
:root[data-theme="dark"] td{border-bottom-color:var(--line)}
:root[data-theme="dark"] tbody tr:hover{background:#192332}
:root[data-theme="dark"] .status.blocked{background:#3a1b24;color:#ff8994}
:root[data-theme="dark"] .status.slow{background:#332713;color:#ffd37a}
:root[data-theme="dark"] .status.ok{background:#173322;color:#6ee092}
:root[data-theme="dark"] .status.proxy_failed{background:#27303d;color:#b4bfcd}
:root[data-theme="dark"] .status.unchecked{background:#202a37;color:#aab4c4}
:root[data-theme="dark"] .diag-state.ok{background:#173322;color:#6ee092}:root[data-theme="dark"] .diag-state.warn{background:#332713;color:#ffd37a}:root[data-theme="dark"] .diag-state.off{background:#202a37;color:#aab4c4}
:root[data-theme="dark"] .capture-banner{background:var(--panel);box-shadow:0 12px 30px rgba(0,0,0,.28)}
:root[data-theme="dark"] .scan-progress{background:var(--panel)}:root[data-theme="dark"] .bar{background:#202a37}
@media(max-width:900px){main{padding:14px}.top{display:block}.actions{justify-content:flex-start;margin-top:14px}.mode-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.capture-banner{grid-template-columns:1fr}.capture-meta{justify-content:flex-start}.toolbar,.utility-grid{grid-template-columns:1fr}.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.stat.wide{grid-column:1/-1}.source-grid,.manual-result,.manual-dpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.manual-panel form{grid-template-columns:1fr}th:nth-child(5),td:nth-child(5),th:nth-child(6),td:nth-child(6){display:none}}
@media(max-width:560px){.summary,.source-grid,.manual-result,.manual-dpi-grid,.mode-strip,.diag-grid{grid-template-columns:1fr}.button{width:100%;justify-content:center}.tool form{display:block}.tool input,.tool select,.tool .button{width:100%;margin-top:8px}th:nth-child(4),td:nth-child(4){display:none}}
</style>
</head>
<body>
<main>
<section class="top">
<div class="brand"><div class="mark">SW</div><div><h1>SiteWatch</h1><div class="subtitle">Мониторинг блокировок по устройствам без постоянного DNS-логирования</div></div></div>
<div class="actions">
<span class="version">$sitewatch_version_e</span>
<a class="button" href="$metrics_path_e">Metrics</a>
<button class="button" id="themeToggle" type="button">Dark</button>
</div>
</section>

<nav class="tabs" aria-label="Разделы SiteWatch">
<button class="tab-button active" type="button" data-tab="overview">Обзор</button>
<button class="tab-button" type="button" data-tab="domains">Домены</button>
<button class="tab-button" type="button" data-tab="manual">Проверка URL</button>
<button class="tab-button" type="button" data-tab="settings">Настройки</button>
<button class="tab-button" type="button" data-tab="diagnostics">Диагностика</button>
</nav>

<section class="tab-panel active" data-tab-panel="overview">
<section class="capture-banner ${capture_state:-idle}" id="captureBanner" data-state="$capture_state" data-start="$capture_time" data-duration="$capture_duration" data-remaining="$capture_remaining">
<div class="capture-left"><span class="pulse"></span><div><b id="captureTitle">$capture_text</b><div class="muted" id="captureDetail">Новые DNS-запросы подхватываются автоматически во время активного окна.</div></div></div>
<div class="capture-meta"><span class="timer" id="captureTimer">${capture_remaining:-}</span> <span class="live-tag" id="captureMode">$capture_mode_text</span></div>
</section>

<section class="toolbar">
<div class="tool">
<div class="tool-title">Проверка устройства</div>
<form method="get" action="">
<input type="hidden" name="action" value="scan">
<label>Источник</label>
<input name="source" value="$source_filter_e" placeholder="192.168.1.50">
<button class="button primary" type="submit">Сканировать устройство</button>
<a class="button" href="?">Сбросить фильтр</a>
</form>
<div class="capture">$capture_text</div>
</div>
<div class="tool">
<div class="tool-title">Окно наблюдения</div>
<form class="capture-controls $capture_controls_class" id="captureControls" method="get" action="">
<input type="hidden" name="action" id="captureAction" value="$capture_action">
<input type="hidden" name="source" value="$source_filter_e">
<select class="capture-start-field" name="duration"><option value="30">30 сек</option><option value="45" selected>45 сек</option><option value="90">90 сек</option><option value="180">180 сек</option><option value="300">300 сек</option></select>
<button class="button $capture_button_class" id="captureSubmit" type="submit">$capture_button_label</button>
<a class="button warn capture-live-link" id="captureLive" href="?action=capture_live$source_q">Live</a>
</form>
</div>
</section>

<section class="summary">
<div class="stat wide"><div class="k">Фильтр / последний скан</div><span class="v" id="summaryScope">$source_title_e · $last_scan</span></div>
<div class="stat"><div class="k">DNS-запросов</div><span class="v" id="summarySeen">$total_seen</span></div>
<div class="stat"><div class="k">Проверено</div><span class="v" id="summaryResults">$total_results</span></div>
<div class="stat"><div class="k">VPN-список</div><span class="v" id="summaryProxy">$total_proxy</span></div>
<div class="stat"><div class="k">Ожидает</div><span class="v">$unchecked_count</span></div>
</section>

<section class="health">
<div class="pill-card"><span><span class="dot blocked"></span>Заблокированы</span><b>$blocked_count</b></div>
<div class="pill-card"><span><span class="dot slow"></span>Замедлены</span><b>$slow_count</b></div>
<div class="pill-card"><span><span class="dot ok"></span>Норма</span><b>$ok_count</b></div>
<div class="pill-card"><span><span class="dot proxy_failed"></span>Proxy fail</span><b>$failed_count</b></div>
<div class="pill-card"><span><span class="dot unchecked"></span>Ожидают</span><b>$unchecked_count</b></div>
</section>

<form class="queue-actions" method="get" action="">
<input type="hidden" name="action" value="scan_pending">
<input type="hidden" name="source" value="$source_filter_e">
<label class="scan-workers">Потоков <input type="number" name="scan_workers" min="1" max="16" step="1" value="$scan_workers_e"></label>
<button class="button primary" type="submit">Распознать ожидающие</button>
<a class="button danger" href="?action=clear_observations" data-confirm="Очистить DNS-запросы, результаты проверок и VPN-список?">Очистить наблюдения</a>
</form>

<section class="scan-progress" id="scanProgress" data-state="$scan_state" data-total="$scan_total" data-done="$scan_done">
<div>
<div class="scan-text" id="scanText">$scan_label_e</div>
<div class="scan-current" id="scanCurrent">$scan_current_e</div>
</div>
<span class="live-tag" id="scanMode">$scan_state</span>
<div class="bar"><span id="scanBar" style="width:${scan_percent}%"></span></div>
</section>

<div class="export-panel">
<div class="tool-title">Выгрузка правил</div>
<form class="export-grid" method="get" action="">
<select name="action">
<option value="export">Все проблемные: domain</option>
<option value="export_blocked">Заблокированные: domain</option>
<option value="export_slow">Замедленные: domain</option>
<option value="export_v2raya">Все проблемные: v2rayA</option>
<option value="export_v2raya_blocked">Заблокированные: v2rayA</option>
<option value="export_v2raya_slow">Замедленные: v2rayA</option>
<option value="export_base">Базовые домены</option>
<option value="export_v2raya_base">Базовые домены: v2rayA</option>
</select>
<button class="button" type="submit">Скачать</button>
</form>
</div>
</section>

<section class="tab-panel" data-tab-panel="manual">
<section class="manual-panel">
<div class="tool-title">Ручная проверка URL</div>
<form method="get" action="" id="manualCheckForm">
<input type="hidden" name="action" value="manual_check">
<input type="text" name="url" value="$manual_url_e" placeholder="https://youmagine.com/">
<label class="checkline"><input type="checkbox" name="add" value="1"> добавить в VPN-список при блокировке</label>
<button class="button primary" type="submit">Проверить URL</button>
</form>
<div class="manual-loading"><span class="spinner"></span><span>Проверяем напрямую и через v2rayA</span></div>
<div class="manual-result" id="manualResult">
EOF

if [ -n "$manual_result" ]; then
cat <<EOF
<div class="manual-metric"><span>Статус</span><b><span class="status $manual_status_e">$manual_status_text_e</span></b></div>
<div class="manual-metric"><span>Домен</span><b>$manual_domain_e</b></div>
<div class="manual-metric"><span>Напрямую</span><b>$manual_direct_code_e / ${manual_direct_time_e} с</b></div>
<div class="manual-metric"><span>Через v2rayA</span><b>$manual_proxy_code_e / ${manual_proxy_time_e} с</b></div>
<div class="manual-metric"><span>URL</span><b>$manual_checked_url_e</b></div>
<div class="manual-metric"><span>VPN-список</span><b>$manual_added_e</b></div>
<details class="manual-dpi">
<summary>DPI-диагностика</summary>
<div class="manual-dpi-grid">
<div class="manual-metric"><span>DNS DPI</span><b>$manual_dns_status_e · UDP $manual_dns_udp_ip_e · DoH $manual_dns_doh_ip_e</b></div>
<div class="manual-metric"><span>TLS 1.3</span><b>$manual_tls13_status_e / ${manual_tls13_time_e} с</b></div>
<div class="manual-metric"><span>TLS 1.2</span><b>$manual_tls12_status_e / ${manual_tls12_time_e} с</b></div>
<div class="manual-metric"><span>HTTP probe</span><b>$manual_http_status_e / $manual_http_code_e</b></div>
</div>
</details>
EOF
fi

cat <<EOF
</div>
</section>
</section>

<section class="tab-panel" data-tab-panel="diagnostics">
<section class="mode-strip">
<div class="diag-item"><span class="diag-state $mode_state">mode</span><b>$mode_label_e</b><small>$mode_hint_e</small></div>
<div class="diag-item"><span class="diag-state $([ "$SITEWATCH_DNSMASQ_CONTROL" = "1" ] && echo ok || echo off)">dnsmasq</span><b>$dnsmasq_control_label_e</b><small>logging: $dns_logging</small></div>
<div class="diag-item"><span class="diag-state $logread_state">logread</span><b>$logread_label_e</b><small>файлы логов ниже</small></div>
<div class="diag-item"><span class="diag-state $go_state">scan</span><b>$go_label_e</b><small>proxy: $proxy_label_e</small></div>
</section>
<div class="source-panel">
<div class="tool-title">Диагностика источников</div>
<div class="source-grid">
<div class="source-card">
<div class="source-row"><b>dnsmasq / logread</b><span class="source-state">$logread_state</span></div>
<div class="muted">$dnsmasq_control_label_e · $logread_label_e</div>
<div class="muted">Текущий dnsmasq logging: $dns_logging</div>
</div>
<div class="source-card">
<div class="source-row"><b>Pi-hole API</b><span class="source-state">$pihole_state</span></div>
<div class="muted">$pihole_label_e</div>
<div class="muted">URL: $pihole_url_e · проверка: $pihole_checked_human</div>
<div style="margin-top:8px"><a class="button" href="?action=pihole_check$source_q">Проверить Pi-hole</a></div>
</div>
<div class="source-card">
<div class="source-row"><b>HTTP/proxy проверки</b><span class="source-state">$go_state</span></div>
<div class="muted">$go_label_e</div>
<div class="muted">Proxy: $proxy_label_e</div>
</div>
<div class="source-card">
<div class="source-row"><b>Prometheus</b><span class="source-state">metrics</span></div>
<div class="muted">Scrape endpoint для контейнера и OpenWrt.</div>
<div style="margin-top:8px"><a class="button" href="$metrics_path_e">Открыть metrics</a></div>
</div>
</div>
<div class="diag-grid">$diagnostic_logs_html</div>
</div>
</section>

<section class="tab-panel" data-tab-panel="settings">
<div class="source-panel">
<div class="tool-title">Текущие параметры</div>
<div class="source-grid">
<div class="source-card"><b>Proxy v2rayA</b><div class="muted">$proxy_label_e</div></div>
<div class="source-card"><b>Потоков распознавания</b><div class="muted">$scan_workers_e</div></div>
<div class="source-card"><b>dnsmasq control</b><div class="muted">$dnsmasq_control_label_e</div></div>
<div class="source-card"><b>logread</b><div class="muted">$logread_label_e</div></div>
<div class="source-card"><b>Pi-hole API</b><div class="muted">$pihole_label_e</div></div>
<div class="source-card"><b>Prometheus</b><div class="muted">$metrics_path_e</div></div>
</div>
<form class="settings-form" method="get" action="">
<input type="hidden" name="action" value="save_settings">
<input type="hidden" name="tab" value="settings">
<label>Потоков распознавания <input type="number" name="scan_workers" min="1" max="16" step="1" value="$scan_workers_e"></label>
<button class="button primary" type="submit">Сохранить</button>
</form>
</div>

</section>

<section class="tab-panel" data-tab-panel="domains">
<nav class="sources">
<a class="chip" href="?">Все устройства</a>
EOF

awk -F '\t' '{
	count[$1] += $5;
}
END {
	for (source in count) print source, count[source];
}' "$SITEWATCH_SEEN" 2>/dev/null | sort | head -n 24 | while read -r src cnt; do
	[ -n "$src" ] || continue
	src_e="$(printf "%s" "$src" | html_escape)"
	active=""
	[ "$src" = "$source_filter" ] && active=" active"
	printf '<a class="chip%s" href="?source=%s">%s <small>%s</small></a>\n' "$active" "$src_e" "$src_e" "$cnt"
done

cat <<EOF
</nav>

<section class="panel">
<div class="panel-head"><div class="panel-title">Домены: $source_title_e</div><div class="hint">Live-режим обновляет счетчики без перезагрузки страницы</div></div>
<table>
<thead><tr><th class="sortable" data-type="text">Статус <span class="sort-indicator"></span></th><th class="sortable" data-type="text">Домен <span class="sort-indicator"></span></th><th class="sortable" data-type="text">Источник <span class="sort-indicator"></span></th><th class="sortable" data-type="number">Запросов <span class="sort-indicator"></span></th><th class="sortable" data-type="text">Напрямую <span class="sort-indicator"></span></th><th class="sortable" data-type="text">Через v2rayA <span class="sort-indicator"></span></th><th class="sortable" data-type="text">DPI <span class="sort-indicator"></span></th><th class="sortable" data-type="text">Скан <span class="sort-indicator"></span></th></tr></thead>
<tbody>
EOF

if false; then
rows="$(
awk -F '\t' -v source_filter="$source_filter" '
	BEGIN { OFS = "\t"; }
	FNR == NR {
		if (source_filter == "" || $1 == source_filter) {
			source[$2] = $1;
			queries[$2] += $5;
		}
		next;
	}
	{
		domain = $1;
		if (source_filter == "" || $2 == source_filter) {
			dpi = (NF >= 10 && $10 != "") ? $10 : "-";
			direct = $5 " / " $6 " с";
			proxy = $7 " / " $8 " с";
			print $4, domain, $2, $3, direct, proxy, dpi, $9;
			done[domain] = 1;
		}
	}
	END {
		for (domain in queries) {
			if (!(domain in done)) print "unchecked", domain, source[domain], queries[domain], "-", "-", "-", "";
		}
	}
' "$SITEWATCH_SEEN" "$SITEWATCH_RESULTS" 2>/dev/null | sort -t "	" -k1,1 -k4,4nr | head -n 250
)"

if [ -z "$rows" ]; then
	printf '<tr><td class="empty" colspan="8">Нет данных для выбранного источника. Запусти окно наблюдения и открой нужный сайт с устройства.</td></tr>\n'
else
	printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r status domain source count direct proxy dpi scanned; do
		[ -n "$domain" ] || continue
		status_class="$(printf "%s" "$status" | html_escape)"
		status_text="$(status_label "$status" | html_escape)"
		domain_e="$(printf "%s" "$domain" | html_escape)"
		source_e="$(printf "%s" "$source" | html_escape)"
		direct_e="$(printf "%s" "$direct" | html_escape)"
		proxy_e="$(printf "%s" "$proxy" | html_escape)"
		dpi_e="$(printf "%s" "${dpi:--}" | html_escape)"
		dpi_note_e="$(dpi_note "${dpi:--}" | html_escape)"
		dpi_class=""
		case "$dpi" in ""|-|ok) ;; *) dpi_class=" detected" ;; esac
		if [ -n "$scanned" ] && [ "$scanned" != "-" ]; then
			scanned="$(date -d "@$scanned" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$scanned")"
		else
			scanned="-"
		fi
		printf '<tr><td><span class="status %s">%s</span></td><td class="domain">%s</td><td class="source">%s</td><td>%s</td><td class="metric">%s</td><td class="metric">%s</td><td><span class="dpi-tag%s" title="%s">%s</span></td><td class="muted">%s</td></tr>\n' \
			"$status_class" "$status_text" "$domain_e" "$source_e" "$count" "$direct_e" "$proxy_e" "$dpi_class" "$dpi_note_e" "$dpi_e" "$scanned"
	done
fi
fi
print_domain_rows "$source_filter"

cat <<'EOF'
</tbody></table>
</section>
</section>
</main>
