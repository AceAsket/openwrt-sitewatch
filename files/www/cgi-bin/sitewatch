:root[data-theme="dark"] td{border-bottom-color:var(--line)}
:root[data-theme="dark"] tbody tr:hover{background:#192332}
:root[data-theme="dark"] .status.blocked{background:#3a1b24;color:#ff8994}
:root[data-theme="dark"] .status.slow{background:#332713;color:#ffd37a}
