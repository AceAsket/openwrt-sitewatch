		printf '<tr><td class="empty" colspan="9">Пассивных conntrack-наблюдений пока нет.</td></tr>\n'
		return 0
	fi
	printf "%s\n" "$rows" | awk -F '\t' 'NF >= 9 { print }' | tail -n 12 | while IFS="$(printf '\t')" read -r ts mode source target port status packets bytes detail; do
		ts_h="$(date -d "@$ts" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$ts")"
		status_text="$(network_status_label "$status")"
		detail_text="$(network_detail_label "$detail")"
		printf '<tr><td class="muted">%s</td><td>%s</td><td class="source">%s</td><td class="source">%s</td><td class="metric">%s</td><td><span class="status %s">%s</span></td><td class="metric">%s</td><td class="metric">%s</td><td class="muted">%s</td></tr>\n' \
			"$(printf "%s" "$ts_h" | html_escape)" "$(printf "%s" "$mode" | html_escape)" "$(printf "%s" "$source" | html_escape)" "$(printf "%s" "$target" | html_escape)" "$(printf "%s" "$port" | html_escape)" "$(printf "%s" "$status" | html_escape)" "$(printf "%s" "$status_text" | html_escape)" "$(printf "%s" "$packets" | html_escape)" "$(printf "%s" "$bytes" | html_escape)" "$(printf "%s" "$detail_text" | html_escape)"
	done
