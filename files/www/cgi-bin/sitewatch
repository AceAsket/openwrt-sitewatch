#!/bin/ash

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_SEEN:=/etc/sitewatch/seen.tsv}"
: "${SITEWATCH_RESULTS:=/etc/sitewatch/results.tsv}"
: "${SITEWATCH_PROXY_OUT:=/etc/sitewatch/proxy-domains.txt}"
: "${SITEWATCH_SCAN_BIN:=/usr/bin/sitewatch-scan}"
: "${SITEWATCH_COLLECT_BIN:=/usr/bin/sitewatch-collect}"
: "${SITEWATCH_CAPTURE_BIN:=/usr/bin/sitewatch-capture}"
: "${SITEWATCH_CHECK_URL_BIN:=/usr/bin/sitewatch-check-url}"
: "${SITEWATCH_CAPTURE_STATUS:=/tmp/sitewatch-capture.status}"
: "${SITEWATCH_CAPTURE_LOCK:=/tmp/sitewatch-capture.lock}"
: "${SITEWATCH_PIHOLE_API_ENABLED:=0}"
: "${SITEWATCH_PIHOLE_URL:=}"
: "${SITEWATCH_PIHOLE_PASSWORD:=}"
: "${SITEWATCH_PIHOLE_STATUS:=/tmp/sitewatch-pihole.status}"

html_escape() {
	sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

param() {
	key="$1"
	printf "%s" "${QUERY_STRING:-}" | tr '&' '\n' | awk -F '=' -v k="$key" '$1 == k { print $2; exit }'
}

safe_token() {
	printf "%s" "$1" | sed 's/%2E/./g; s/%2e/./g' | awk '/^[A-Za-z0-9_.:-]+$/ { print; exit }'
}

url_decode_light() {
	printf "%s" "$1" | sed \
		-e 's/+/ /g' \
		-e 's/%20/ /Ig' \
		-e 's/%3A/:/Ig' \
		-e 's/%2F/\//Ig' \
		-e 's/%3F/?/Ig' \
		-e 's/%3D/=/Ig' \
		-e 's/%26/\&/Ig' \
		-e 's/%23/#/Ig' \
		-e 's/%25/%/Ig' \
		-e 's/%22/"/Ig' \
		-e "s/%27/'/Ig" \
		-e 's/%28/(/Ig' \
		-e 's/%29/)/Ig' \
		-e 's/%2C/,/Ig' \
		-e 's/%3B/;/Ig' \
		-e 's/%3C/</Ig' \
		-e 's/%3E/>/Ig' \
		-e 's/%5B/[/Ig' \
		-e 's/%5D/]/Ig' \
		-e 's/%60/`/Ig' \
		-e 's/%2E/./Ig' \
		-e 's/%2D/-/Ig' \
		-e 's/%5F/_/Ig' \
		-e 's/%7E/~/Ig'
}

base_domain() {
	awk -v d="$1" '
		BEGIN {
			n = split(d, p, ".");
			if (n <= 2) {
				print d;
				exit;
			}
			suffix = p[n - 1] "." p[n];
			if (suffix ~ /^(co|com|net|org|ac|gov|edu)\.(uk|jp|kr|nz|za|br)$/ && n >= 3) {
				print p[n - 2] "." suffix;
			} else {
				print suffix;
			}
		}
	'
}

print_proxy_domains() {
	mode="$1"
	[ -f "$SITEWATCH_PROXY_OUT" ] || return 0
	while read -r item; do
		domain="${item#domain:}"
		[ -n "$domain" ] || continue
		case "$mode" in
			base) base_domain "$domain" ;;
			v2raya) printf "domain(domain: %s) -> proxy\n" "$domain" ;;
			v2raya_base) printf "domain(domain: %s) -> proxy\n" "$(base_domain "$domain")" ;;
			*) printf "domain:%s\n" "$domain" ;;
		esac
	done < "$SITEWATCH_PROXY_OUT" | sort -u
}

status_label() {
	case "$1" in
		blocked) echo "заблокирован" ;;
		slow) echo "замедлен" ;;
		ok) echo "норма" ;;
		proxy_failed) echo "proxy fail" ;;
		unchecked) echo "ожидает" ;;
		*) echo "$1" ;;
	esac
}

action="$(param action)"
source_filter="$(safe_token "$(param source)")"
duration="$(safe_token "$(param duration)")"
manual_url="$(url_decode_light "$(param url)")"
manual_add="$(safe_token "$(param add)")"
[ -n "$duration" ] || duration=45
source_q=""
[ -n "$source_filter" ] && source_q="&source=$source_filter"
manual_result=""

case "$action" in
	capture)
		"$SITEWATCH_CAPTURE_BIN" "$duration" >/dev/null 2>&1 &
		sleep 1
		;;
	capture_live)
		"$SITEWATCH_CAPTURE_BIN" 0 >/dev/null 2>&1 &
		sleep 1
		;;
	capture_stop)
		"$SITEWATCH_CAPTURE_BIN" stop >/dev/null 2>&1
		sleep 1
		;;
	collect)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		;;
	pihole_check)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		;;
	status)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
		printf "capture=%s\n" "$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
		printf "dns_logging=%s\n" "$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
		printf "seen=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $1 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_SEEN" 2>/dev/null)"
		printf "results=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $2 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
		printf "proxy=%s\n" "$(wc -l < "$SITEWATCH_PROXY_OUT" 2>/dev/null || echo 0)"
		exit 0
		;;
	scan)
		if [ -n "$source_filter" ]; then
			SITEWATCH_SOURCE_FILTER="$source_filter" SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1
		else
			SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1
		fi
		;;
	manual_check)
		if [ -n "$manual_url" ]; then
			if [ "$manual_add" = "1" ]; then
				manual_result="$("$SITEWATCH_CHECK_URL_BIN" --add "$manual_url" 2>/dev/null || true)"
			else
				manual_result="$("$SITEWATCH_CHECK_URL_BIN" "$manual_url" 2>/dev/null || true)"
			fi
		fi
		;;
	manual_check_api)
		printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
		if [ -n "$manual_url" ]; then
			if [ "$manual_add" = "1" ]; then
				"$SITEWATCH_CHECK_URL_BIN" --add "$manual_url" 2>/dev/null || true
			else
				"$SITEWATCH_CHECK_URL_BIN" "$manual_url" 2>/dev/null || true
			fi
		else
			printf "status\terror\nerror\tempty_url\n"
		fi
		exit 0
		;;
	export)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-domains.txt\"\r\n\r\n"
		print_proxy_domains normal
		exit 0
		;;
	export_base)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-base-domains.txt\"\r\n\r\n"
		print_proxy_domains base
		exit 0
		;;
	export_v2raya)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-rules.txt\"\r\n\r\n"
		print_proxy_domains v2raya
		exit 0
		;;
	export_v2raya_base)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-base-rules.txt\"\r\n\r\n"
		print_proxy_domains v2raya_base
		exit 0
		;;
esac

filter_awk='1'
[ -n "$source_filter" ] && filter_awk='$2 == source_filter'

total_seen="$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $1 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_SEEN" 2>/dev/null)"
total_results="$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $2 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
total_proxy="$(wc -l < "$SITEWATCH_PROXY_OUT" 2>/dev/null || echo 0)"
blocked_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "blocked" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
slow_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "slow" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
ok_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "ok" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
failed_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "proxy_failed" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
unchecked_count=$((total_seen - total_results))
[ "$unchecked_count" -lt 0 ] && unchecked_count=0
last_scan="$(awk -F '\t' -v source_filter="$source_filter" 'BEGIN{m=0} (source_filter == "" || $2 == source_filter) && $9>m{m=$9} END{print m}' "$SITEWATCH_RESULTS" 2>/dev/null)"
[ -n "$last_scan" ] && [ "$last_scan" != "0" ] && last_scan="$(date -d "@$last_scan" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$last_scan")" || last_scan="нет данных"
dns_logging="$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
capture_status="$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
capture_text="DNS-логирование выключено"
[ "$dns_logging" = "1" ] && capture_text="DNS-логирование включено"
capture_state=""
capture_time=""
capture_duration=""
capture_last=""
capture_remaining=""
if [ -n "$capture_status" ]; then
	capture_state="$(printf "%s" "$capture_status" | awk -F '\t' '{print $1}')"
	capture_time="$(printf "%s" "$capture_status" | awk -F '\t' '{print $2}')"
	capture_duration="$(printf "%s" "$capture_status" | awk -F '\t' '{print $3}')"
	capture_last="$(printf "%s" "$capture_status" | awk -F '\t' '{print $4}')"
	capture_when="$(date -d "@$capture_time" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$capture_time")"
	[ "$capture_state" = "done" ] && capture_text="Последнее окно: $capture_duration сек, $capture_when"
	[ "$capture_state" = "running" ] && capture_text="Идет окно наблюдения: $capture_duration сек"
	[ "$capture_state" = "running" ] && [ "$capture_duration" = "0" ] && capture_text="Идет live-наблюдение без таймера"
	[ "$capture_state" = "stopped" ] && capture_text="Live-наблюдение остановлено: $capture_when"
	if [ "$capture_state" = "running" ] && [ "$capture_duration" != "0" ]; then
		now_for_remaining="$(date +%s)"
		capture_remaining=$((capture_time + capture_duration - now_for_remaining))
		[ "$capture_remaining" -lt 0 ] && capture_remaining=0
	fi
fi

pihole_status_raw="$(cat "$SITEWATCH_PIHOLE_STATUS" 2>/dev/null || true)"
pihole_state="disabled"
pihole_count="0"
pihole_checked=""
[ "$SITEWATCH_PIHOLE_API_ENABLED" = "1" ] && pihole_state="configured"
if [ "$SITEWATCH_PIHOLE_API_ENABLED" = "1" ] && [ -n "$pihole_status_raw" ]; then
	pihole_state="$(printf "%s" "$pihole_status_raw" | awk -F '\t' '{print $1}')"
	pihole_count="$(printf "%s" "$pihole_status_raw" | awk -F '\t' '{print $3}')"
	pihole_checked="$(printf "%s" "$pihole_status_raw" | awk -F '\t' '{print $4}')"
fi
pihole_label="Pi-hole API выключен"
[ "$pihole_state" = "configured" ] && pihole_label="Pi-hole API настроен, проверка не запускалась"
[ "$pihole_state" = "ok" ] && pihole_label="Pi-hole API работает, записей: $pihole_count"
[ "$pihole_state" = "auth_failed" ] && pihole_label="Pi-hole API: ошибка авторизации"
[ "$pihole_state" = "not_configured" ] && pihole_label="Pi-hole API включен, но URL/пароль не заданы"
[ -n "$pihole_checked" ] && pihole_checked_human="$(date -d "@$pihole_checked" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$pihole_checked")" || pihole_checked_human="нет"
[ -n "$SITEWATCH_PIHOLE_URL" ] && pihole_url_label="$SITEWATCH_PIHOLE_URL" || pihole_url_label="не задан"
pihole_label_e="$(printf "%s" "$pihole_label" | html_escape)"
pihole_url_e="$(printf "%s" "$pihole_url_label" | html_escape)"

source_title="Все устройства"
[ -n "$source_filter" ] && source_title="$source_filter"
source_title_e="$(printf "%s" "$source_title" | html_escape)"
source_filter_e="$(printf "%s" "$source_filter" | html_escape)"
manual_url_e="$(printf "%s" "$manual_url" | html_escape)"

manual_status=""
manual_status_text=""
manual_domain=""
manual_checked_url=""
manual_direct_code=""
manual_direct_time=""
manual_proxy_code=""
manual_proxy_time=""
manual_dns_status=""
manual_dns_udp_ip=""
manual_dns_doh_ip=""
manual_tls13_status=""
manual_tls13_time=""
manual_tls12_status=""
manual_tls12_time=""
manual_http_status=""
manual_http_code=""
manual_added=""
if [ -n "$manual_result" ]; then
	manual_status="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "status" { print $2; exit }')"
	manual_status_text="$(status_label "$manual_status")"
	manual_domain="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "domain" { print $2; exit }')"
	manual_checked_url="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "url" { print $2; exit }')"
	manual_direct_code="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "direct_code" { print $2; exit }')"
	manual_direct_time="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "direct_time" { print $2; exit }')"
	manual_proxy_code="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "proxy_code" { print $2; exit }')"
	manual_proxy_time="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "proxy_time" { print $2; exit }')"
	manual_dns_status="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "dns_status" { print $2; exit }')"
	manual_dns_udp_ip="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "dns_udp_ip" { print $2; exit }')"
	manual_dns_doh_ip="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "dns_doh_ip" { print $2; exit }')"
	manual_tls13_status="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "tls13_status" { print $2; exit }')"
	manual_tls13_time="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "tls13_time" { print $2; exit }')"
	manual_tls12_status="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "tls12_status" { print $2; exit }')"
	manual_tls12_time="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "tls12_time" { print $2; exit }')"
	manual_http_status="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "http_status" { print $2; exit }')"
	manual_http_code="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "http_code" { print $2; exit }')"
	manual_added="$(printf "%s\n" "$manual_result" | awk -F '\t' '$1 == "added" { print $2; exit }')"
fi
manual_status_e="$(printf "%s" "$manual_status" | html_escape)"
manual_status_text_e="$(printf "%s" "$manual_status_text" | html_escape)"
manual_domain_e="$(printf "%s" "$manual_domain" | html_escape)"
manual_checked_url_e="$(printf "%s" "$manual_checked_url" | html_escape)"
manual_direct_code_e="$(printf "%s" "$manual_direct_code" | html_escape)"
manual_direct_time_e="$(printf "%s" "$manual_direct_time" | html_escape)"
manual_proxy_code_e="$(printf "%s" "$manual_proxy_code" | html_escape)"
manual_proxy_time_e="$(printf "%s" "$manual_proxy_time" | html_escape)"
manual_dns_status_e="$(printf "%s" "$manual_dns_status" | html_escape)"
manual_dns_udp_ip_e="$(printf "%s" "$manual_dns_udp_ip" | html_escape)"
manual_dns_doh_ip_e="$(printf "%s" "$manual_dns_doh_ip" | html_escape)"
manual_tls13_status_e="$(printf "%s" "$manual_tls13_status" | html_escape)"
manual_tls13_time_e="$(printf "%s" "$manual_tls13_time" | html_escape)"
manual_tls12_status_e="$(printf "%s" "$manual_tls12_status" | html_escape)"
manual_tls12_time_e="$(printf "%s" "$manual_tls12_time" | html_escape)"
manual_http_status_e="$(printf "%s" "$manual_http_status" | html_escape)"
manual_http_code_e="$(printf "%s" "$manual_http_code" | html_escape)"
manual_added_e="$(printf "%s" "$manual_added" | html_escape)"

printf "Content-Type: text/html; charset=utf-8\r\n\r\n"
cat <<EOF
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SiteWatch</title>
<script>
(function(){
  var params = new URLSearchParams(window.location.search);
  var requested = params.get('theme');
  var saved = requested === 'light' || requested === 'dark' ? requested : localStorage.getItem('sitewatch-theme');
  var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
})();
</script>
<style>
