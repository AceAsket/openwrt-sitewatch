  }
  function render(){
    if (!banner || !timer || !mode) return;
    var state = banner.getAttribute('data-state') || 'idle';
    var duration = parseInt(banner.getAttribute('data-duration') || '0', 10);
    var start = parseInt(banner.getAttribute('data-start') || '0', 10);
    if (state === 'running' && duration > 0 && start > 0) {
      var left = Math.max(0, start + duration - Math.floor(Date.now() / 1000));
      timer.textContent = left + ' с';
      mode.textContent = 'таймер';
      if (left === 0 && !reloadedAfterDone) {
        reloadedAfterDone = true;
        setTimeout(function(){ location.reload(); }, 2200);
      }
    } else if (state === 'running') {
      timer.textContent = 'live';
      mode.textContent = 'без таймера';
    } else {
      timer.textContent = '';
      mode.textContent = modeLabels[state] || state || 'ожидает';
    }
  }
  render();
  setScan(scanProgress ? [scanProgress.getAttribute('data-state') || '', '', scanProgress.getAttribute('data-total') || '0', scanProgress.getAttribute('data-done') || '0', scanCurrent ? scanCurrent.textContent : ''].join('\t') : '');
  setDetector(detectorProgress ? [detectorProgress.getAttribute('data-state') || '', '', detectorProgress.getAttribute('data-total') || '0', detectorProgress.getAttribute('data-done') || '0', detectorCurrent ? detectorCurrent.textContent : '', '', ''].join('\t') : '');
  setInterval(render, 1000);
  function refreshStatus(){
    if (!banner) return;
      var url = endpoint + '?action=status' + (source ? '&source=' + encodeURIComponent(source) : '');
      fetch(url, {cache:'no-store'}).then(function(resp){ return resp.text(); }).then(function(text){
        var data = parseStatus(text);
        if (data.capture) setCapture(data.capture);
        if (data.scan) setScan(data.scan);
        if (data.detector) setDetector(data.detector);
        if (data.seen && seen) seen.textContent = data.seen;
        if (data.results && results) results.textContent = data.results;
        if (data.proxy && proxyTotal) proxyTotal.textContent = data.proxy;
        if (data.pending != null) window.sitewatchPending = data.pending;
        var rowsSignature = [data.capture || '', data.scan || '', data.seen || '', data.results || '', data.pending || ''].join('|');
        if (rowsSignature !== lastRowsSignature && window.sitewatchRefreshRows) {
          lastRowsSignature = rowsSignature;
          window.sitewatchRefreshRows();
        }
        var pending = Math.max(0, asNumber(data.pending || window.sitewatchPending || '0'));
        if (data.scan && data.scan.indexOf('done\t') === 0 && pending > 0 && !autoScanPending) {
          autoScanPending = true;
          setTimeout(function(){
            var workers = scanWorkersInput ? scanWorkersInput.value : '';
            fetch(endpoint + '?action=scan_pending' + (source ? '&source=' + encodeURIComponent(source) : '') + (workers ? '&scan_workers=' + encodeURIComponent(workers) : ''), {cache:'no-store'})
              .catch(function(){})
              .finally(function(){ autoScanPending = false; });
          }, 1800);
        }
        render();
      }).catch(function(){});
  }
  setTimeout(refreshStatus, 1200);
  setInterval(refreshStatus, 6000);
})();
</script>
<script>
(function(){
  var table = document.querySelector('.panel table');
  if (!table || !table.tBodies.length) return;
  var tbody = table.tBodies[0];
  var activeIndex = -1;
  var activeDir = 1;
  var refreshInFlight = false;
  var source = '$source_filter_e';
  function value(row, index, type){
    var raw = (row.cells[index] ? row.cells[index].textContent : '').trim();
    if (type === 'number') {
      var num = parseFloat(raw.replace(',', '.'));
      return isNaN(num) ? 0 : num;
    }
    return raw.toLowerCase();
  }
  function applySort(){
    if (activeIndex < 0) return;
    var th = table.querySelectorAll('th.sortable')[activeIndex];
    if (!th) return;
    var type = th.getAttribute('data-type') || 'text';
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr')).filter(function(row){
      return !row.querySelector('.empty');
    });
    rows.sort(function(a, b){
      var av = value(a, activeIndex, type);
      var bv = value(b, activeIndex, type);
      if (av < bv) return -1 * activeDir;
      if (av > bv) return 1 * activeDir;
      return 0;
    });
    rows.forEach(function(row){ tbody.appendChild(row); });
    table.querySelectorAll('.sort-indicator').forEach(function(node){ node.textContent = ''; });
    var indicator = th.querySelector('.sort-indicator');
    if (indicator) indicator.textContent = activeDir > 0 ? '↑' : '↓';
  }
  table.querySelectorAll('th.sortable').forEach(function(th, index){
    th.addEventListener('click', function(){
      activeDir = activeIndex === index ? -activeDir : 1;
      activeIndex = index;
      applySort();
    });
  });
  window.sitewatchRefreshRows = function(){
    if (refreshInFlight || !window.fetch) return;
    refreshInFlight = true;
    fetch((window.location.pathname || '/') + '?action=rows' + (source ? '&source=' + encodeURIComponent(source) : ''), {cache:'no-store'})
      .then(function(resp){ return resp.text(); })
      .then(function(html){
        if (html && html.indexOf('<tr') !== -1) {
          tbody.innerHTML = html;
          applySort();
        }
      })
      .catch(function(){})
      .finally(function(){ refreshInFlight = false; });
  };
})();
</script>
<script>
(function(){
  var endpoint = window.location.pathname || '/';
  var form = document.getElementById('manualCheckForm');
  var panel = form ? form.closest('.manual-panel') : null;
  var result = document.getElementById('manualResult');
  var proxyTotal = document.getElementById('summaryProxy');
  if (!form || !panel || !result || !window.fetch) return;

  var labels = {
    blocked: 'заблокирован',
    slow: 'замедлен',
    ok: 'норма',
    proxy_failed: 'proxy fail',
    error: 'ошибка'
  };

  function parseTSV(text){
    var out = {};
    text.trim().split('\n').forEach(function(line){
      var idx = line.indexOf('\t');
      if (idx > -1) out[line.slice(0, idx)] = line.slice(idx + 1);
    });
    return out;
  }

  function text(value){
    return value == null || value === '' ? '-' : String(value);
  }

  function metric(title, body){
    var box = document.createElement('div');
    box.className = 'manual-metric';
    var label = document.createElement('span');
    label.textContent = title;
    var value = document.createElement('b');
    if (body instanceof Node) value.appendChild(body);
    else value.textContent = text(body);
    box.appendChild(label);
    box.appendChild(value);
    return box;
  }

  function render(data){
    result.textContent = '';
    var status = data.status || 'error';
    var badge = document.createElement('span');
    badge.className = 'status ' + status;
    badge.textContent = labels[status] || status;
    result.appendChild(metric('Статус', badge));
    result.appendChild(metric('Домен', data.domain));
    result.appendChild(metric('Напрямую', text(data.direct_code) + ' / ' + text(data.direct_time) + ' с'));
    result.appendChild(metric('Через v2rayA', text(data.proxy_code) + ' / ' + text(data.proxy_time) + ' с'));
    result.appendChild(metric('URL', data.url));
    result.appendChild(metric('VPN-список', data.added || data.error || 'no'));
    var details = document.createElement('details');
    details.className = 'manual-dpi';
    var summary = document.createElement('summary');
    summary.textContent = 'DPI-диагностика';
    var grid = document.createElement('div');
    grid.className = 'manual-dpi-grid';
    grid.appendChild(metric('DNS DPI', text(data.dns_status) + ' · UDP ' + text(data.dns_udp_ip) + ' · DoH ' + text(data.dns_doh_ip)));
    grid.appendChild(metric('TLS 1.3', text(data.tls13_status) + ' / ' + text(data.tls13_time) + ' с'));
    grid.appendChild(metric('TLS 1.2', text(data.tls12_status) + ' / ' + text(data.tls12_time) + ' с'));
    grid.appendChild(metric('HTTP probe', text(data.http_status) + ' / ' + text(data.http_code)));
    details.appendChild(summary);
    details.appendChild(grid);
    result.appendChild(details);
  }

  function cleanManualInput(value){
    var raw = String(value || '').replace(/\s+/g, '').replace(/^[ "'`<>\[\]{}(),;]+|[ "'`<>\[\]{}(),;]+$/g, '');
    var idx = raw.toLowerCase().indexOf('domain:');
    if (idx >= 0) {
      raw = raw.slice(idx + 7).replace(/^[ "'`<>\[\]{}(),;]+/, '');
      var match = raw.match(/^[A-Za-z0-9.-]+/);
      raw = match ? match[0] : '';
    }
    return raw;
  }

  form.addEventListener('submit', function(event){
    event.preventDefault();
    var input = form.querySelector('input[name="url"]');
    if (input) input.value = cleanManualInput(input.value);
    var params = new URLSearchParams(new FormData(form));
    params.set('action', 'manual_check_api');
    panel.classList.add('loading');
    result.textContent = '';
    var button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    fetch(endpoint + '?' + params.toString(), {cache:'no-store'})
      .then(function(resp){ return resp.text(); })
      .then(function(body){
        var data = parseTSV(body);
        render(data);
        if ((data.added === 'yes' || data.added === 'already') && proxyTotal) {
          fetch(endpoint + '?action=status', {cache:'no-store'})
            .then(function(resp){ return resp.text(); })
            .then(function(text){
              var status = parseTSV(text.replace(/=/g, '\t'));
              if (status.proxy) proxyTotal.textContent = status.proxy;
              if (window.sitewatchRefreshRows) window.sitewatchRefreshRows();
            }).catch(function(){});
        }
      })
      .catch(function(){
        render({status:'error', error:'network'});
      })
      .finally(function(){
        panel.classList.remove('loading');
        if (button) button.disabled = false;
      });
  });
})();
</script>
</body>
</html>
