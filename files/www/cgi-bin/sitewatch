#!/bin/ash

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_VERSION:=v0.2.0}"
: "${SITEWATCH_SEEN:=/etc/sitewatch/seen.tsv}"
: "${SITEWATCH_RESULTS:=/etc/sitewatch/results.tsv}"
: "${SITEWATCH_PROXY_OUT:=/etc/sitewatch/proxy-domains.txt}"
: "${SITEWATCH_LOG_FILES:=/var/log/pihole/pihole.log /tmp/log/dnsmasq.log /var/log/messages}"
: "${SITEWATCH_USE_LOGREAD:=1}"
: "${SITEWATCH_CLEAR_LOGREAD:=1}"
: "${SITEWATCH_DNSMASQ_CONTROL:=1}"
: "${SITEWATCH_GO_BIN:=/usr/bin/sitewatch}"
: "${SITEWATCH_SCAN_BIN:=/usr/bin/sitewatch-scan}"
: "${SITEWATCH_COLLECT_BIN:=/usr/bin/sitewatch-collect}"
: "${SITEWATCH_CAPTURE_BIN:=/usr/bin/sitewatch-capture}"
: "${SITEWATCH_CHECK_URL_BIN:=/usr/bin/sitewatch-check-url}"
: "${SITEWATCH_SCAN_WORKERS:=4}"
: "${SITEWATCH_CAPTURE_STATUS:=/tmp/sitewatch-capture.status}"
: "${SITEWATCH_SCAN_STATUS:=/tmp/sitewatch-scan.status}"
: "${SITEWATCH_CAPTURE_LOCK:=/tmp/sitewatch-capture.lock}"
: "${SITEWATCH_PIHOLE_API_ENABLED:=0}"
: "${SITEWATCH_PIHOLE_URL:=}"
: "${SITEWATCH_PIHOLE_PASSWORD:=}"
: "${SITEWATCH_PIHOLE_STATUS:=/tmp/sitewatch-pihole.status}"

html_escape() {
	sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

param() {
	key="$1"
	printf "%s" "${QUERY_STRING:-}" | tr '&' '\n' | awk -F '=' -v k="$key" '$1 == k { print $2; exit }'
}

safe_token() {
	printf "%s" "$1" | sed 's/%2E/./g; s/%2e/./g' | awk '/^[A-Za-z0-9_.:-]+$/ { print; exit }'
}

normalize_scan_workers() {
	value="$1"
	case "$value" in
		""|*[!0-9]*) return 1 ;;
	esac
	[ "$value" -lt 1 ] && value=1
	[ "$value" -gt 16 ] && value=16
	printf "%s" "$value"
}

save_config_value() {
	key="$1"
	value="$2"
	tmp="/tmp/sitewatch-conf.$$"
	[ -f "$CONF" ] || : > "$CONF" 2>/dev/null || return 0
	awk -v key="$key" -v value="$value" '
		BEGIN { done = 0 }
		$0 ~ "^" key "=" { print key "=\"" value "\""; done = 1; next }
		{ print }
		END { if (!done) print key "=\"" value "\"" }
	' "$CONF" > "$tmp" && cp "$tmp" "$CONF"
	rm -f "$tmp"
}

clear_dns_logs() {
	for log in $SITEWATCH_LOG_FILES; do
		case "$log" in
			/tmp/log/*|/var/log/*)
				[ -f "$log" ] && : > "$log" 2>/dev/null || true
				;;
		esac
	done
	if [ "$SITEWATCH_USE_LOGREAD" = "1" ] && [ "$SITEWATCH_CLEAR_LOGREAD" = "1" ] && command -v logread >/dev/null 2>&1; then
		if logread -c >/dev/null 2>&1; then
			:
		elif [ -x /etc/init.d/log ]; then
			/etc/init.d/log restart >/dev/null 2>&1 || true
		fi
	fi
}

url_decode_light() {
	printf "%s" "$1" | sed \
		-e 's/+/ /g' \
		-e 's/%20/ /Ig' \
		-e 's/%3A/:/Ig' \
		-e 's/%2F/\//Ig' \
		-e 's/%3F/?/Ig' \
		-e 's/%3D/=/Ig' \
		-e 's/%26/\&/Ig' \
		-e 's/%23/#/Ig' \
		-e 's/%25/%/Ig' \
		-e 's/%22/"/Ig' \
		-e "s/%27/'/Ig" \
		-e 's/%28/(/Ig' \
		-e 's/%29/)/Ig' \
		-e 's/%2C/,/Ig' \
		-e 's/%3B/;/Ig' \
		-e 's/%3C/</Ig' \
		-e 's/%3E/>/Ig' \
		-e 's/%5B/[/Ig' \
		-e 's/%5D/]/Ig' \
		-e 's/%60/`/Ig' \
		-e 's/%2E/./Ig' \
		-e 's/%2D/-/Ig' \
		-e 's/%5F/_/Ig' \
		-e 's/%7E/~/Ig'
}

base_domain() {
	awk -v d="$1" '
		BEGIN {
			n = split(d, p, ".");
			if (n <= 2) {
				print d;
				exit;
			}
			suffix = p[n - 1] "." p[n];
			if (suffix ~ /^(co|com|net|org|ac|gov|edu)\.(uk|jp|kr|nz|za|br)$/ && n >= 3) {
				print p[n - 2] "." suffix;
			} else {
				print suffix;
			}
		}
	'
}

print_proxy_domains() {
	mode="$1"
	[ -f "$SITEWATCH_PROXY_OUT" ] || return 0
	while read -r item; do
		domain="${item#domain:}"
		[ -n "$domain" ] || continue
		case "$mode" in
			base) base_domain "$domain" ;;
			v2raya) printf "domain(domain: %s) -> proxy\n" "$domain" ;;
			v2raya_base) printf "domain(domain: %s) -> proxy\n" "$(base_domain "$domain")" ;;
			*) printf "domain:%s\n" "$domain" ;;
		esac
	done < "$SITEWATCH_PROXY_OUT" | sort -u
}

print_result_domains() {
	status_filter="$1"
	mode="$2"
	[ -f "$SITEWATCH_RESULTS" ] || return 0
	awk -F '\t' -v status_filter="$status_filter" '
		status_filter == "problem" && ($4 == "blocked" || $4 == "slow") { print $1; next }
		status_filter != "problem" && $4 == status_filter { print $1; next }
	' "$SITEWATCH_RESULTS" | while read -r domain; do
		[ -n "$domain" ] || continue
		case "$mode" in
			base) base_domain "$domain" ;;
			v2raya) printf "domain(domain: %s) -> proxy\n" "$domain" ;;
			v2raya_base) printf "domain(domain: %s) -> proxy\n" "$(base_domain "$domain")" ;;
			*) printf "domain:%s\n" "$domain" ;;
		esac
	done | sort -u
}

status_label() {
	case "$1" in
		blocked) echo "заблокирован" ;;
		slow) echo "замедлен" ;;
		ok) echo "норма" ;;
		proxy_failed) echo "proxy fail" ;;
		unchecked) echo "ожидает" ;;
		*) echo "$1" ;;
	esac
}

capture_label() {
	case "$1" in
		running) echo "идет" ;;
		done) echo "завершено" ;;
		stopped) echo "остановлено" ;;
		idle|"") echo "ожидает" ;;
		*) echo "$1" ;;
	esac
}

dpi_note() {
	case "$1" in
		ok) echo "DNS UDP совпал с DoH, явных признаков DPI нет" ;;
		spoofed) echo "DNS-ответ отличается от DoH: возможная подмена DNS" ;;
		intercepted) echo "UDP DNS не отвечает или перехватывается, DoH доступен" ;;
		blocked) echo "DNS-проверки не прошли: возможная блокировка резолвинга" ;;
		tls13_*) echo "TLS 1.3 probe дал сбой: возможная фильтрация по TLS" ;;
		tls12_*) echo "TLS 1.2 probe дал сбой: возможная фильтрация по TLS" ;;
		http_isp_page) echo "HTTP probe похож на страницу провайдера/блокировки" ;;
		http_*) echo "HTTP probe дал нетипичный результат" ;;
		""|"-") echo "DPI-метка еще не записана для этой строки" ;;
		*) echo "DPI-метка: $1" ;;
	esac
}

prom_escape() {
	printf "%s" "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

num_or_zero() {
	case "$1" in
		""|*[!0-9]*) printf "0" ;;
		*) printf "%s" "$1" ;;
	esac
}

print_metrics() {
	now="$(date +%s)"
	capture_raw="$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
	scan_raw="$(cat "$SITEWATCH_SCAN_STATUS" 2>/dev/null || true)"
	pihole_raw="$(cat "$SITEWATCH_PIHOLE_STATUS" 2>/dev/null || true)"
	capture_state_m="$(printf "%s" "$capture_raw" | awk -F '\t' '{print $1}')"
	scan_state_m="$(printf "%s" "$scan_raw" | awk -F '\t' '{print $1}')"
	scan_total_m="$(printf "%s" "$scan_raw" | awk -F '\t' '{print $3}')"
	scan_done_m="$(printf "%s" "$scan_raw" | awk -F '\t' '{print $4}')"
	pihole_state_m="disabled"
	pihole_count_m="0"
	seen_metrics_file="$SITEWATCH_SEEN"
	results_metrics_file="$SITEWATCH_RESULTS"
	[ -f "$seen_metrics_file" ] || seen_metrics_file="/dev/null"
	[ -f "$results_metrics_file" ] || results_metrics_file="/dev/null"
	[ "$SITEWATCH_PIHOLE_API_ENABLED" = "1" ] && pihole_state_m="configured"
	if [ -n "$pihole_raw" ]; then
		pihole_state_m="$(printf "%s" "$pihole_raw" | awk -F '\t' '{print $1}')"
		pihole_count_m="$(printf "%s" "$pihole_raw" | awk -F '\t' '{print $3}')"
	fi
	if command -v uci >/dev/null 2>&1; then
		dns_logging_m="$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
	else
		dns_logging_m="0"
	fi
	printf "Content-Type: text/plain; version=0.0.4; charset=utf-8\r\n\r\n"
	printf "# HELP sitewatch_info SiteWatch build information.\n"
	printf "# TYPE sitewatch_info gauge\n"
	printf "sitewatch_info{version=\"%s\"} 1\n" "$(prom_escape "$SITEWATCH_VERSION")"
	printf "# HELP sitewatch_seen_pairs_total Observed source/domain pairs.\n# TYPE sitewatch_seen_pairs_total gauge\n"
	awk -F '\t' 'BEGIN{n=0;q=0}{n++;q+=$5}END{printf "sitewatch_seen_pairs_total %d\nsitewatch_dns_queries_total %d\n", n, q}' "$seen_metrics_file" 2>/dev/null
	printf "# HELP sitewatch_results_total Scan results by status.\n# TYPE sitewatch_results_total gauge\n"
	awk -F '\t' 'BEGIN{status["blocked"]=0;status["slow"]=0;status["ok"]=0;status["proxy_failed"]=0}{status[$4]++}END{for(s in status) printf "sitewatch_results_total{status=\"%s\"} %d\n", s, status[s]}' "$results_metrics_file" 2>/dev/null
	pending_m="$(awk -F '\t' 'FNR == NR { result[$1] = 1; next } !result[$2] && !seen[$2]++ { n++ } END { print n + 0 }' "$results_metrics_file" "$seen_metrics_file" 2>/dev/null)"
	printf "# HELP sitewatch_pending_domains Domains waiting for scan.\n# TYPE sitewatch_pending_domains gauge\nsitewatch_pending_domains %s\n" "$(num_or_zero "$pending_m")"
	proxy_count_m="0"
	[ -f "$SITEWATCH_PROXY_OUT" ] && proxy_count_m="$(wc -l < "$SITEWATCH_PROXY_OUT" 2>/dev/null || echo 0)"
	printf "# HELP sitewatch_proxy_domains Domains in VPN export list.\n# TYPE sitewatch_proxy_domains gauge\nsitewatch_proxy_domains %s\n" "$(num_or_zero "$proxy_count_m")"
	[ "$capture_state_m" = "running" ] && capture_running_m=1 || capture_running_m=0
	[ "$scan_state_m" = "running" ] && scan_running_m=1 || scan_running_m=0
	printf "# HELP sitewatch_capture_running Capture window state.\n# TYPE sitewatch_capture_running gauge\nsitewatch_capture_running %s\n" "$capture_running_m"
	printf "# HELP sitewatch_scan_running Scan worker state.\n# TYPE sitewatch_scan_running gauge\nsitewatch_scan_running %s\n" "$scan_running_m"
	printf "# HELP sitewatch_scan_progress Current scan batch progress.\n# TYPE sitewatch_scan_progress gauge\nsitewatch_scan_progress{part=\"done\"} %s\nsitewatch_scan_progress{part=\"total\"} %s\n" "$(num_or_zero "$scan_done_m")" "$(num_or_zero "$scan_total_m")"
	printf "# HELP sitewatch_dnsmasq_control_enabled Whether SiteWatch is allowed to control local dnsmasq logging.\n# TYPE sitewatch_dnsmasq_control_enabled gauge\nsitewatch_dnsmasq_control_enabled %s\n" "$([ "$SITEWATCH_DNSMASQ_CONTROL" = "1" ] && echo 1 || echo 0)"
	printf "# HELP sitewatch_dnsmasq_logging_enabled Current dnsmasq query logging state when readable.\n# TYPE sitewatch_dnsmasq_logging_enabled gauge\nsitewatch_dnsmasq_logging_enabled %s\n" "$([ "$dns_logging_m" = "1" ] && echo 1 || echo 0)"
	printf "# HELP sitewatch_pihole_imported_pairs Last imported source/domain pairs from Pi-hole API.\n# TYPE sitewatch_pihole_imported_pairs gauge\nsitewatch_pihole_imported_pairs{status=\"%s\"} %s\n" "$(prom_escape "$pihole_state_m")" "$(num_or_zero "$pihole_count_m")"
	printf "# HELP sitewatch_log_file_readable Configured DNS log file readability.\n# TYPE sitewatch_log_file_readable gauge\n"
	for log in $SITEWATCH_LOG_FILES; do
		[ -r "$log" ] && readable=1 || readable=0
		printf "sitewatch_log_file_readable{path=\"%s\"} %s\n" "$(prom_escape "$log")" "$readable"
	done
	printf "# HELP sitewatch_last_scrape_timestamp_seconds SiteWatch metrics render time.\n# TYPE sitewatch_last_scrape_timestamp_seconds gauge\nsitewatch_last_scrape_timestamp_seconds %s\n" "$now"
}

print_domain_rows() {
	source_filter="$1"
	rows="$(
	awk -F '\t' -v source_filter="$source_filter" '
		BEGIN { OFS = "\t"; }
		FNR == NR {
			if (source_filter == "" || $1 == source_filter) {
				source[$2] = $1;
				queries[$2] += $5;
			}
			next;
		}
		{
			domain = $1;
			if (source_filter == "" || $2 == source_filter) {
				dpi = (NF >= 10 && $10 != "") ? $10 : "-";
				direct = $5 " / " $6 " с";
				proxy = $7 " / " $8 " с";
				print $4, domain, $2, $3, direct, proxy, dpi, $9;
				done[domain] = 1;
			}
		}
		END {
			for (domain in queries) {
				if (!(domain in done)) print "unchecked", domain, source[domain], queries[domain], "-", "-", "-", "";
			}
		}
	' "$SITEWATCH_SEEN" "$SITEWATCH_RESULTS" 2>/dev/null | sort -t "	" -k1,1 -k4,4nr | head -n 250
	)"

	if [ -z "$rows" ]; then
		printf '<tr><td class="empty" colspan="8">Нет данных для выбранного источника. Запусти окно наблюдения и открой нужный сайт с устройства.</td></tr>\n'
	else
		printf "%s\n" "$rows" | while IFS="$(printf '\t')" read -r status domain source count direct proxy dpi scanned; do
			[ -n "$domain" ] || continue
			status_class="$(printf "%s" "$status" | html_escape)"
			status_text="$(status_label "$status" | html_escape)"
			domain_e="$(printf "%s" "$domain" | html_escape)"
			source_e="$(printf "%s" "$source" | html_escape)"
			direct_e="$(printf "%s" "$direct" | html_escape)"
			proxy_e="$(printf "%s" "$proxy" | html_escape)"
			dpi_e="$(printf "%s" "${dpi:--}" | html_escape)"
			dpi_note_e="$(dpi_note "${dpi:--}" | html_escape)"
			dpi_class=""
			case "$dpi" in ""|-|ok) ;; *) dpi_class=" detected" ;; esac
			if [ -n "$scanned" ] && [ "$scanned" != "-" ]; then
				scanned="$(date -d "@$scanned" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$scanned")"
			else
				scanned="-"
			fi
			scanned_e="$(printf "%s" "$scanned" | html_escape)"
			printf '<tr><td><span class="status %s">%s</span></td><td class="domain">%s</td><td class="source">%s</td><td class="metric">%s</td><td class="metric">%s</td><td class="metric">%s</td><td><span class="dpi-tag%s" title="%s">%s</span></td><td class="muted">%s</td></tr>\n' "$status_class" "$status_text" "$domain_e" "$source_e" "$count" "$direct_e" "$proxy_e" "$dpi_class" "$dpi_note_e" "$dpi_e" "$scanned_e"
		done
	fi
}

action="$(param action)"
source_filter="$(safe_token "$(param source)")"
duration="$(safe_token "$(param duration)")"
manual_url="$(url_decode_light "$(param url)")"
manual_add="$(safe_token "$(param add)")"
scan_workers="$(normalize_scan_workers "$(safe_token "$(param scan_workers)")")"
[ -n "$scan_workers" ] || scan_workers="$(normalize_scan_workers "$SITEWATCH_SCAN_WORKERS")"
[ -n "$scan_workers" ] || scan_workers=4
SITEWATCH_SCAN_WORKERS="$scan_workers"
[ -n "$duration" ] || duration=45
source_q=""
[ -n "$source_filter" ] && source_q="&source=$source_filter"
manual_result=""

case "$action" in
	capture)
		"$SITEWATCH_CAPTURE_BIN" "$duration" >/dev/null 2>&1 &
		sleep 1
		;;
	capture_live)
		"$SITEWATCH_CAPTURE_BIN" 0 >/dev/null 2>&1 &
		sleep 1
		;;
	capture_stop)
		"$SITEWATCH_CAPTURE_BIN" stop >/dev/null 2>&1
		sleep 1
		;;
	collect)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		;;
	pihole_check)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		;;
	save_settings)
		save_config_value SITEWATCH_SCAN_WORKERS "$scan_workers"
		;;
	status)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
		printf "capture=%s\n" "$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
		printf "scan=%s\n" "$(cat "$SITEWATCH_SCAN_STATUS" 2>/dev/null || true)"
		if command -v uci >/dev/null 2>&1; then
			printf "dns_logging=%s\n" "$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
		else
			printf "dns_logging=0\n"
		fi
		printf "seen=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $1 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_SEEN" 2>/dev/null)"
		printf "results=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $2 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
		printf "pending=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'FNR == NR { if (source_filter == "" || $2 == source_filter) result[$1] = 1; next } (source_filter == "" || $1 == source_filter) && !result[$2] && !seen[$2]++ { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" "$SITEWATCH_SEEN" 2>/dev/null)"
		proxy_status_count="0"
		[ -f "$SITEWATCH_PROXY_OUT" ] && proxy_status_count="$(wc -l < "$SITEWATCH_PROXY_OUT" 2>/dev/null || echo 0)"
		printf "proxy=%s\n" "$proxy_status_count"
		exit 0
		;;
	metrics)
		print_metrics
		exit 0
		;;
	rows)
		printf "Content-Type: text/html; charset=utf-8\r\n\r\n"
		print_domain_rows "$source_filter"
		exit 0
		;;
	scan)
		save_config_value SITEWATCH_SCAN_WORKERS "$scan_workers"
		if [ -n "$source_filter" ]; then
			SITEWATCH_SOURCE_FILTER="$source_filter" SITEWATCH_SCAN_WORKERS="$scan_workers" SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1 &
		else
			SITEWATCH_SCAN_WORKERS="$scan_workers" SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1 &
		fi
		sleep 1
		;;
	scan_pending)
		save_config_value SITEWATCH_SCAN_WORKERS "$scan_workers"
		if [ -n "$source_filter" ]; then
			SITEWATCH_SOURCE_FILTER="$source_filter" SITEWATCH_SCAN_WORKERS="$scan_workers" "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1 &
		else
			SITEWATCH_SCAN_WORKERS="$scan_workers" "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1 &
		fi
		sleep 1
		;;
	clear_observations)
		: > "$SITEWATCH_SEEN"
		: > "$SITEWATCH_QUEUE"
		: > "$SITEWATCH_RESULTS"
		: > "$SITEWATCH_PROXY_OUT"
		rm -f "$SITEWATCH_SCAN_STATUS"
		clear_dns_logs
		;;
	manual_check)
		if [ -n "$manual_url" ]; then
			if [ "$manual_add" = "1" ]; then
				manual_result="$("$SITEWATCH_CHECK_URL_BIN" --add "$manual_url" 2>/dev/null || true)"
			else
				manual_result="$("$SITEWATCH_CHECK_URL_BIN" "$manual_url" 2>/dev/null || true)"
			fi
		fi
		;;
	manual_check_api)
		printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
		if [ -n "$manual_url" ]; then
			if [ "$manual_add" = "1" ]; then
				"$SITEWATCH_CHECK_URL_BIN" --add "$manual_url" 2>/dev/null || true
			else
				"$SITEWATCH_CHECK_URL_BIN" "$manual_url" 2>/dev/null || true
			fi
		else
			printf "status\terror\nerror\tempty_url\n"
		fi
		exit 0
		;;
	export)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-domains.txt\"\r\n\r\n"
		print_result_domains problem normal
		exit 0
		;;
	export_blocked)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"blocked-domains.txt\"\r\n\r\n"
		print_result_domains blocked normal
		exit 0
		;;
	export_slow)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"slow-domains.txt\"\r\n\r\n"
		print_result_domains slow normal
		exit 0
		;;
	export_base)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-base-domains.txt\"\r\n\r\n"
		print_result_domains problem base
		exit 0
		;;
	export_v2raya)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-rules.txt\"\r\n\r\n"
		print_result_domains problem v2raya
		exit 0
		;;
	export_v2raya_blocked)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-blocked-rules.txt\"\r\n\r\n"
		print_result_domains blocked v2raya
		exit 0
		;;
	export_v2raya_slow)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-slow-rules.txt\"\r\n\r\n"
		print_result_domains slow v2raya
		exit 0
		;;
	export_v2raya_base)
