			"$(printf "%s" "$ts_h" | html_escape)" "$(printf "%s" "$mode" | html_escape)" "$(printf "%s" "$target" | html_escape)" "$(printf "%s" "$port" | html_escape)" "$(printf "%s" "$status" | html_escape)" "$(printf "%s" "$status_text" | html_escape)" "$(printf "%s" "$rtt" | html_escape)" "$(printf "%s" "$detail_text" | html_escape)"
