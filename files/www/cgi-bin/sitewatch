#!/bin/ash

CONF="/etc/sitewatch/sitewatch.conf"
[ -f "$CONF" ] && . "$CONF"

: "${SITEWATCH_SEEN:=/etc/sitewatch/seen.tsv}"
: "${SITEWATCH_RESULTS:=/etc/sitewatch/results.tsv}"
: "${SITEWATCH_PROXY_OUT:=/etc/sitewatch/proxy-domains.txt}"
: "${SITEWATCH_SCAN_BIN:=/usr/bin/sitewatch-scan}"
: "${SITEWATCH_COLLECT_BIN:=/usr/bin/sitewatch-collect}"
: "${SITEWATCH_CAPTURE_BIN:=/usr/bin/sitewatch-capture}"
: "${SITEWATCH_CAPTURE_STATUS:=/tmp/sitewatch-capture.status}"
: "${SITEWATCH_CAPTURE_LOCK:=/tmp/sitewatch-capture.lock}"

html_escape() {
	sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

param() {
	key="$1"
	printf "%s" "${QUERY_STRING:-}" | tr '&' '\n' | awk -F '=' -v k="$key" '$1 == k { print $2; exit }'
}

safe_token() {
	printf "%s" "$1" | sed 's/%2E/./g; s/%2e/./g' | awk '/^[A-Za-z0-9_.:-]+$/ { print; exit }'
}

base_domain() {
	awk -v d="$1" '
		BEGIN {
			n = split(d, p, ".");
			if (n <= 2) {
				print d;
				exit;
			}
			suffix = p[n - 1] "." p[n];
			if (suffix ~ /^(co|com|net|org|ac|gov|edu)\.(uk|jp|kr|nz|za|br)$/ && n >= 3) {
				print p[n - 2] "." suffix;
			} else {
				print suffix;
			}
		}
	'
}

print_proxy_domains() {
	mode="$1"
	[ -f "$SITEWATCH_PROXY_OUT" ] || return 0
	while read -r item; do
		domain="${item#domain:}"
		[ -n "$domain" ] || continue
		case "$mode" in
			base) base_domain "$domain" ;;
			v2raya) printf "domain(domain: %s) -> proxy\n" "$domain" ;;
			v2raya_base) printf "domain(domain: %s) -> proxy\n" "$(base_domain "$domain")" ;;
			*) printf "domain:%s\n" "$domain" ;;
		esac
	done < "$SITEWATCH_PROXY_OUT" | sort -u
}

status_label() {
	case "$1" in
		blocked) echo "заблокирован" ;;
		slow) echo "замедлен" ;;
		ok) echo "норма" ;;
		proxy_failed) echo "proxy fail" ;;
		unchecked) echo "ожидает" ;;
		*) echo "$1" ;;
	esac
}

action="$(param action)"
source_filter="$(safe_token "$(param source)")"
duration="$(safe_token "$(param duration)")"
[ -n "$duration" ] || duration=45
source_q=""
[ -n "$source_filter" ] && source_q="&source=$source_filter"

case "$action" in
	capture)
		"$SITEWATCH_CAPTURE_BIN" "$duration" >/dev/null 2>&1 &
		;;
	capture_live)
		"$SITEWATCH_CAPTURE_BIN" 0 >/dev/null 2>&1 &
		;;
	capture_stop)
		"$SITEWATCH_CAPTURE_BIN" stop >/dev/null 2>&1
		;;
	collect)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		;;
	status)
		"$SITEWATCH_COLLECT_BIN" >/dev/null 2>&1
		printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
		printf "capture=%s\n" "$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
		printf "dns_logging=%s\n" "$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
		printf "seen=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $1 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_SEEN" 2>/dev/null)"
		printf "results=%s\n" "$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $2 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
		exit 0
		;;
	scan)
		if [ -n "$source_filter" ]; then
			SITEWATCH_SOURCE_FILTER="$source_filter" SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1
		else
			SITEWATCH_FORCE_RESCAN=1 "$SITEWATCH_SCAN_BIN" >/dev/null 2>&1
		fi
		;;
	export)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-domains.txt\"\r\n\r\n"
		print_proxy_domains normal
		exit 0
		;;
	export_base)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"proxy-base-domains.txt\"\r\n\r\n"
		print_proxy_domains base
		exit 0
		;;
	export_v2raya)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-rules.txt\"\r\n\r\n"
		print_proxy_domains v2raya
		exit 0
		;;
	export_v2raya_base)
		printf "Content-Type: text/plain; charset=utf-8\r\n"
		printf "Content-Disposition: attachment; filename=\"v2raya-base-rules.txt\"\r\n\r\n"
		print_proxy_domains v2raya_base
		exit 0
		;;
esac

filter_awk='1'
[ -n "$source_filter" ] && filter_awk='$2 == source_filter'

total_seen="$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $1 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_SEEN" 2>/dev/null)"
total_results="$(awk -F '\t' -v source_filter="$source_filter" 'source_filter == "" || $2 == source_filter { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
total_proxy="$(wc -l < "$SITEWATCH_PROXY_OUT" 2>/dev/null || echo 0)"
blocked_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "blocked" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
slow_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "slow" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
ok_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "ok" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
failed_count="$(awk -F '\t' -v source_filter="$source_filter" '$4 == "proxy_failed" && (source_filter == "" || $2 == source_filter) { n++ } END { print n + 0 }' "$SITEWATCH_RESULTS" 2>/dev/null)"
unchecked_count=$((total_seen - total_results))
[ "$unchecked_count" -lt 0 ] && unchecked_count=0
last_scan="$(awk -F '\t' -v source_filter="$source_filter" 'BEGIN{m=0} (source_filter == "" || $2 == source_filter) && $9>m{m=$9} END{print m}' "$SITEWATCH_RESULTS" 2>/dev/null)"
[ -n "$last_scan" ] && [ "$last_scan" != "0" ] && last_scan="$(date -d "@$last_scan" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$last_scan")" || last_scan="нет данных"
dns_logging="$(uci -q get dhcp.@dnsmasq[0].logqueries || echo 0)"
capture_status="$(cat "$SITEWATCH_CAPTURE_STATUS" 2>/dev/null || true)"
capture_text="DNS-логирование выключено"
[ "$dns_logging" = "1" ] && capture_text="DNS-логирование включено"
capture_state=""
capture_time=""
capture_duration=""
capture_last=""
capture_remaining=""
if [ -n "$capture_status" ]; then
	capture_state="$(printf "%s" "$capture_status" | awk -F '\t' '{print $1}')"
	capture_time="$(printf "%s" "$capture_status" | awk -F '\t' '{print $2}')"
	capture_duration="$(printf "%s" "$capture_status" | awk -F '\t' '{print $3}')"
	capture_last="$(printf "%s" "$capture_status" | awk -F '\t' '{print $4}')"
	capture_when="$(date -d "@$capture_time" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$capture_time")"
	[ "$capture_state" = "done" ] && capture_text="Последнее окно: $capture_duration сек, $capture_when"
	[ "$capture_state" = "running" ] && capture_text="Идет окно наблюдения: $capture_duration сек"
	[ "$capture_state" = "running" ] && [ "$capture_duration" = "0" ] && capture_text="Идет live-наблюдение без таймера"
	[ "$capture_state" = "stopped" ] && capture_text="Live-наблюдение остановлено: $capture_when"
	if [ "$capture_state" = "running" ] && [ "$capture_duration" != "0" ]; then
		now_for_remaining="$(date +%s)"
		capture_remaining=$((capture_time + capture_duration - now_for_remaining))
		[ "$capture_remaining" -lt 0 ] && capture_remaining=0
	fi
fi

source_title="Все устройства"
[ -n "$source_filter" ] && source_title="$source_filter"
source_title_e="$(printf "%s" "$source_title" | html_escape)"
source_filter_e="$(printf "%s" "$source_filter" | html_escape)"

printf "Content-Type: text/html; charset=utf-8\r\n\r\n"
cat <<EOF
